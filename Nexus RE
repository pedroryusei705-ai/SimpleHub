        end)

        table.insert(pages, page)
        table.insert(pageButtons, btn)

        btn.MouseButton1Click:Connect(function()
            Window:SwitchPage(page)
        end)

        return page
    end

    function Window:SwitchPage(targetPage)
        for _, p in ipairs(pages) do
            p.Visible = false
