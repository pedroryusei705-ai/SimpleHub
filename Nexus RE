        Theme:Tween(bg, {
            BackgroundColor3 = value and Theme.Colors.Primary or Theme.Colors.SurfaceLight,
            BackgroundTransparency = value and 0.1 or Theme.Transparency.SurfaceLight
        })
        Theme:Tween(circle, {
            Position = value and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        })
    end

    Core:RegisterWidget(flag, widget)
    return container, widget
