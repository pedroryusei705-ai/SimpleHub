        SliderHeight = 4,
        ButtonHeight = 35,
        SectionHeight = 30,
    },
    Animations = {
        Duration = 0.2,
        EasingStyle = Enum.EasingStyle.Quad,
        EasingDirection = Enum.EasingDirection.Out,
    },
    Transparency = {
