local ProfileManager = {}

local PROFILES_FOLDER = "NexusHub/Profiles/"
local LAST_PROFILE_FILE = "NexusHub/lastprofile.txt"

local function hasFileSystem()
    return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

if not hasFileSystem() then
    warn("[ProfileManager] Sistema de arquivos não disponível. As funções de perfil não funcionarão.")
end

function ProfileManager:ensureFolder()
    if not hasFileSystem() then return false end
    if not isfolder(PROFILES_FOLDER) then
        makefolder(PROFILES_FOLDER)
    end
    return true
end

function ProfileManager:listProfiles()
    if not hasFileSystem() then return {} end
    self:ensureFolder()
    local files = listfiles(PROFILES_FOLDER)
    local profiles = {}
    for _, file in ipairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then
            table.insert(profiles, name)
        end
    end
    table.sort(profiles)
    return profiles
end

function ProfileManager:saveProfile(name, data)
    if not hasFileSystem() then return false end
    self:ensureFolder()
    local path = PROFILES_FOLDER .. name .. ".json"
    local content = game:GetService("HttpService"):JSONEncode(data)
    writefile(path, content)
    return true
end

function ProfileManager:loadProfile(name)
    if not hasFileSystem() then return nil end
    local path = PROFILES_FOLDER .. name .. ".json"
    if not isfile(path) then return nil end
    local content = readfile(path)
    local data = game:GetService("HttpService"):JSONDecode(content)
    return data
end

function ProfileManager:deleteProfile(name)
    if not hasFileSystem() then return false end
    local path = PROFILES_FOLDER .. name .. ".json"
    if isfile(path) then
        delfile(path)
        return true
    end
    return false
end

function ProfileManager:renameProfile(oldName, newName)
    if not hasFileSystem() then return false end
    local oldPath = PROFILES_FOLDER .. oldName .. ".json"
    local newPath = PROFILES_FOLDER .. newName .. ".json"
    if not isfile(oldPath) then return false end
    if isfile(newPath) then return false end
    local content = readfile(oldPath)
    writefile(newPath, content)
    delfile(oldPath)
    return true
end

function ProfileManager:duplicateProfile(name, newName)
    if not hasFileSystem() then return false end
    local oldPath = PROFILES_FOLDER .. name .. ".json"
    local newPath = PROFILES_FOLDER .. newName .. ".json"
    if not isfile(oldPath) then return false end
    if isfile(newPath) then return false end
    local content = readfile(oldPath)
    writefile(newPath, content)
    return true
end

function ProfileManager:saveLastProfile(name)
    if not hasFileSystem() then return end
    writefile(LAST_PROFILE_FILE, name)
end

function ProfileManager:loadLastProfile()
    if not hasFileSystem() then return nil end
    if not isfile(LAST_PROFILE_FILE) then return nil end
    return readfile(LAST_PROFILE_FILE)
end

function ProfileManager:getCurrentProfileData()
    local data = {}
    for flag, value in pairs(Core.Flags) do
        data[flag] = value
    end
    return data
end

function ProfileManager:applyProfile(data)
    for flag, value in pairs(data) do
        Core:SetFlag(flag, value)
    end
end

