local Teleport = {}

Teleport.Config = {
    MAX_TELEPORT_DISTANCE = 200,
    TELEPORT_SPEED = 120,
    TELEPORT_NPC_FOLDER = nil,
}

Teleport.State = {
    isTeleporting = false,
}

function Teleport:getCharComponents()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return nil end
    return root, hum
end

function Teleport:ultraSmoothTeleport(targetPosition)
    if self.State.isTeleporting then return false end
    local root = self:getCharComponents()
    if not root then return false end
    self.State.isTeleporting = true
    local startPos = root.Position
    local distance = (targetPosition - startPos).Magnitude
    if distance < 10 then
        root.CFrame = CFrame.new(targetPosition)
        self.State.isTeleporting = false
        return true
    end
    if distance > self.Config.MAX_TELEPORT_DISTANCE then
        local direction = (targetPosition - startPos).Unit
        local numChunks = math.ceil(distance / self.Config.MAX_TELEPORT_DISTANCE)
        for i = 1, numChunks do
            if not self.State.isTeleporting then break end
            local chunkTarget = (i == numChunks) and targetPosition or (startPos + direction * self.Config.MAX_TELEPORT_DISTANCE * i)
            local chunkTime = (chunkTarget - root.Position).Magnitude / self.Config.TELEPORT_SPEED
            local tween = Core.Services.TweenService:Create(root, TweenInfo.new(chunkTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = CFrame.new(chunkTarget) })
            tween:Play()
            tween.Completed:Wait()
            task.wait(0.1)
        end
    else
        local travelTime = distance / self.Config.TELEPORT_SPEED
        local tween = Core.Services.TweenService:Create(root, TweenInfo.new(travelTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = CFrame.new(targetPosition) })
        tween:Play()
        tween.Completed:Wait()
    end
    self.State.isTeleporting = false
    return true
end

function Teleport:safeTeleportToNPC(npcName)
    if not self.Config.TELEPORT_NPC_FOLDER then
        return false, "No NPC folder"
    end
    local root = self:getCharComponents()
    if not root then return false, "Character not found" end
    for _, npc in ipairs(self.Config.TELEPORT_NPC_FOLDER:GetChildren()) do
        if npc.Name == npcName and npc:IsA("Model") then
            local npcRoot = npc:FindFirstChild("HumanoidRootPart")
            if npcRoot then
                task.spawn(function()
                    self:ultraSmoothTeleport(npcRoot.Position + Vector3.new(0, 2, 5))
                end)
                return true, "Teleporting..."
            end
        end
    end
    return false, "NPC not found"
end

function Teleport:getNPCList()
    local list = {}
    if not self.Config.TELEPORT_NPC_FOLDER then
        return list
    end
    for _, npc in ipairs(self.Config.TELEPORT_NPC_FOLDER:GetChildren()) do
        if npc:IsA("Model") and npc:FindFirstChild("HumanoidRootPart") then
            local name = npc.Name
            if not table.find(list, name) then
                table.insert(list, name)
            end
        end
    end
    table.sort(list)
    return list
end

local liveNPCs = workspace:FindFirstChild("LiveNPCS")
if liveNPCs then
    Teleport.Config.TELEPORT_NPC_FOLDER = liveNPCs
else
    local candidates = { "NPCs", "Alive", "Enemies" }
    for _, name in ipairs(candidates) do
        local folder = workspace:FindFirstChild(name)
        if folder then
            Teleport.Config.TELEPORT_NPC_FOLDER = folder
            break
        end
    end
end
