function refreshProfileList()
    for _, child in ipairs(listContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local profiles = ProfileManager:listProfiles()
    local filtered = {}
    for _, name in ipairs(profiles) do
        if searchQuery == "" or name:lower():find(searchQuery) then
            table.insert(filtered, name)
        end
    end

    if #filtered == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -10, 0, 30)
        empty.BackgroundTransparency = 1
        empty.Text = "   Nenhum perfil encontrado"
        empty.Font = Theme.Fonts.Default
        empty.TextSize = 11
        empty.TextColor3 = Theme.Colors.TextMuted
        empty.TextXAlignment = Enum.TextXAlignment.Left
        empty.Parent = listContainer
        return
    end

    local lastLoaded = ProfileManager:loadLastProfile()

    for _, name in ipairs(filtered) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 28)
        btn.BackgroundColor3 = Theme.Colors.SurfaceLight
        btn.BackgroundTransparency = 0.5
        btn.Text = ""
        btn.BorderSizePixel = 0
        btn.Parent = listContainer
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
        corner.Parent = btn

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -20, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        local isCurrent = (name == lastLoaded)
        local icon = isCurrent and "★ " or "□ "
        label.Text = icon .. name
        label.Font = Theme.Fonts.Default
        label.TextSize = 11
        label.TextColor3 = isCurrent and Theme.Colors.Warning or Theme.Colors.Text
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = btn

        btn.MouseButton1Click:Connect(function()
            selectedProfile = name
            loadProfile(name)
            refreshProfileList()
        end)
    end

    listContainer.Size = UDim2.new(1, 0, 0, math.min(#filtered * 32 + 12, 200))
end

function loadProfile(name)
    if not name then return end
    local data = ProfileManager:loadProfile(name)
    if data then
        ProfileManager:applyProfile(data)
        ProfileManager:saveLastProfile(name)
        lastLoadedProfile = name
        Core:Notify("Perfil \"" .. name .. "\" carregado!")
        print("[ProfileManager] Perfil carregado:", name)
    else
        Core:Notify("Falha ao carregar perfil: " .. name, 2)
    end
end

function saveProfile(name)
    if not name or name == "" then return end
    local data = ProfileManager:getCurrentProfileData()
    if ProfileManager:saveProfile(name, data) then
        ProfileManager:saveLastProfile(name)
        Core:Notify("Perfil \"" .. name .. "\" salvo!")
        refreshProfileList()
    else
        Core:Notify("Falha ao salvar perfil!", 2)
    end
end

function saveProfileAs()
    promptForName("Salvar como...", "", function(name)
        if name and name ~= "" then
            saveProfile(name)
        end
    end)
end

createActionButton("Criar", Theme.Colors.Primary, function()
    promptForName("Criar novo perfil", "", function(name)
        if name and name ~= "" then
            if table.find(ProfileManager:listProfiles(), name) then
                Core:Notify("Perfil já existe!", 2)
                return
            end
            saveProfile(name)
        end
    end)
end)

createActionButton("Renomear", Theme.Colors.Warning, function()
    if not selectedProfile then
        Core:Notify("Selecione um perfil primeiro!", 2)
        return
    end
    promptForName("Renomear para...", selectedProfile, function(newName)
        if newName and newName ~= "" and newName ~= selectedProfile then
            if table.find(ProfileManager:listProfiles(), newName) then
                Core:Notify("Já existe um perfil com esse nome!", 2)
                return
            end
            if ProfileManager:renameProfile(selectedProfile, newName) then
                Core:Notify("Perfil renomeado!")
                selectedProfile = newName
                refreshProfileList()
            else
                Core:Notify("Falha ao renomear!", 2)
            end
        end
    end)
end)

createActionButton("Duplicar", Theme.Colors.Primary, function()
    if not selectedProfile then
        Core:Notify("Selecione um perfil primeiro!", 2)
        return
    end
    promptForName("Duplicar como...", selectedProfile .. "_copy", function(newName)
        if newName and newName ~= "" then
            if table.find(ProfileManager:listProfiles(), newName) then
                Core:Notify("Já existe um perfil com esse nome!", 2)
                return
            end
            if ProfileManager:duplicateProfile(selectedProfile, newName) then
                Core:Notify("Perfil duplicado!")
                refreshProfileList()
            else
                Core:Notify("Falha ao duplicar!", 2)
            end
        end
    end)
end)

createActionButton("Deletar", Theme.Colors.Danger, function()
    if not selectedProfile then
        Core:Notify("Selecione um perfil primeiro!", 2)
        return
    end
    if selectedProfile == ProfileManager:loadLastProfile() then
        Core:Notify("Não é possível deletar o perfil atual!", 2)
        return
    end
    if ProfileManager:deleteProfile(selectedProfile) then
        Core:Notify("Perfil deletado!")
        selectedProfile = nil
        refreshProfileList()
    else
        Core:Notify("Falha ao deletar!", 2)
    end
end)

createActionButton("Atualizar", Theme.Colors.Primary, function()
