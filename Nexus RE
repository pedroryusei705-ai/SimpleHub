    local initial = Core:GetFlag(flag, default)
    bg.BackgroundColor3 = initial and Theme.Colors.Primary or Theme.Colors.SurfaceLight
    bg.BackgroundTransparency = initial and 0.1 or Theme.Transparency.SurfaceLight
    circle.Position = initial and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)

    btn.MouseButton1Click:Connect(function()
        setState(not Core:GetFlag(flag))
