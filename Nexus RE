function Widgets:Slider(parent, config)
    local flag = config.flag
    local label = config.label
    local desc = config.desc
    local min = config.min or 0
    local max = config.max or 100
    local default = config.default or 50
    local step = config.step or 1

    if Core:GetFlag(flag) == nil then
        Core:SetFlag(flag, default)
    end

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, desc and 65 or 50)
    container.BackgroundColor3 = Theme.Colors.Surface
    container.BackgroundTransparency = Theme.Transparency.Surface
    container.BorderSizePixel = 0
    container.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
    corner.Parent = container

    local labelObj = Instance.new("TextLabel")
    labelObj.Size = UDim2.new(0.6, -10, 0, 20)
    labelObj.Position = UDim2.new(0, 10, 0, desc and 6 or 8)
    labelObj.BackgroundTransparency = 1
    labelObj.Text = label
    labelObj.Font = Theme.Fonts.Default
    labelObj.TextSize = 12
    labelObj.TextColor3 = Theme.Colors.Text
    labelObj.TextXAlignment = Enum.TextXAlignment.Left
    labelObj.Parent = container

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.3, -10, 0, 20)
    valueLabel.Position = UDim2.new(0.7, 0, 0, desc and 6 or 8)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default)
    valueLabel.Font = Theme.Fonts.Mono
    valueLabel.TextSize = 12
    valueLabel.TextColor3 = Theme.Colors.TextDim
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = container

    if desc then
        local descObj = Instance.new("TextLabel")
        descObj.Size = UDim2.new(1, -20, 0, 18)
        descObj.Position = UDim2.new(0, 10, 0, 28)
        descObj.BackgroundTransparency = 1
        descObj.Text = desc
        descObj.Font = Theme.Fonts.Default
        descObj.TextSize = 9
        descObj.TextColor3 = Theme.Colors.TextMuted
        descObj.TextWrapped = true
        descObj.Parent = container
    end

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(0.9, 0, 0, Theme.Sizes.SliderHeight)
    sliderBg.Position = UDim2.new(0.05, 0, 1, -(desc and 28 or 12))
    sliderBg.BackgroundColor3 = Theme.Colors.SurfaceLight
    sliderBg.BackgroundTransparency = Theme.Transparency.SurfaceLight
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = container
    local cornerBg = Instance.new("UICorner")
    cornerBg.CornerRadius = UDim.new(1, 0)
    cornerBg.Parent = sliderBg

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Colors.Primary
    fill.BackgroundTransparency = 0.3
    fill.BorderSizePixel = 0
    fill.Parent = sliderBg
    local cornerFill = Instance.new("UICorner")
    cornerFill.CornerRadius = UDim.new(1, 0)
    cornerFill.Parent = fill

    local thumb = Instance.new("TextButton")
    thumb.Size = UDim2.new(0, 14, 0, 14)
    thumb.Position = UDim2.new(0, -7, 0.5, -7)
    thumb.BackgroundColor3 = Theme.Colors.Primary
    thumb.BackgroundTransparency = 0.2
    thumb.BorderSizePixel = 0
    thumb.Text = ""
    thumb.Parent = sliderBg
    local cornerThumb = Instance.new("UICorner")
    cornerThumb.CornerRadius = UDim.new(1, 0)
    cornerThumb.Parent = thumb
    local strokeThumb = Instance.new("UIStroke")
    strokeThumb.Color = Theme.Colors.Stroke
    strokeThumb.Thickness = 1
    strokeThumb.Transparency = 0.3
    strokeThumb.Parent = thumb

    local function updateVisual(value)
        if type(value) ~= "number" then
            value = default
        end
        local clamped = math.clamp(value, min, max)
        if step then
            clamped = math.floor(clamped / step + 0.5) * step
        end
        local percent = (clamped - min) / (max - min)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        thumb.Position = UDim2.new(percent, -7, 0.5, -7)
        valueLabel.Text = tostring(clamped)
        return clamped
    end

    local function setValue(value)
        local clamped = updateVisual(value)
        Core:SetFlag(flag, clamped)
    end

    local dragging = false

    local function handleSliderInput(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local pos = input.Position.X - sliderBg.AbsolutePosition.X
            local size = sliderBg.AbsoluteSize.X
            local percent = math.clamp(pos / size, 0, 1)
            local value = min + (max - min) * percent
            setValue(value)
        end
    end

    sliderBg.InputBegan:Connect(handleSliderInput)
    thumb.InputBegan:Connect(handleSliderInput)

    Core.Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = input.Position.X - sliderBg.AbsolutePosition.X
            local size = sliderBg.AbsoluteSize.X
            local percent = math.clamp(pos / size, 0, 1)
            local value = min + (max - min) * percent
            setValue(value)
        end
    end)

    Core.Services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    local initial = Core:GetFlag(flag, default)
    updateVisual(initial)

    local widget = {}
    function widget:Update(value)
        updateVisual(value)
    end

    Core:RegisterWidget(flag, widget)
    return container, widget
end

