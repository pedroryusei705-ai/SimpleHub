local ESP = {}

ESP.espObjects = {}
ESP.tracerLines = {}
ESP.healthBarObjects = {}
ESP.playerESPObjects = {}
ESP.fovDrawingCircle = nil

function ESP:Init()
    Core.Connections.ESPUpdate = Core.Services.RunService.RenderStepped:Connect(function()
        self:UpdateVisuals()
        self:UpdateTracersAndFOV()
        self:UpdatePlayerESP()
    end)

    Core:Connect("FlagChanged", function(flag, value)
        if flag == "ESPEnabled" and not value then
            self:ClearAllESP()
        end
        if flag == "TracersEnabled" and not value then
            self:ClearAllTracers()
        end
        if flag == "HealthBarsEnabled" and not value then
            self:ClearAllHealthBars()
        end
        if flag == "FOVEnabled" and not value then
            self:RemoveFOVCircle()
        end
    end)
end

function ESP:GetNPCTargets()
    local targets = {}
    local alive = workspace:FindFirstChild("Alive")
    if not alive then
        for _, model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= player.Character then
                local hum = model:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 and model:FindFirstChild("HumanoidRootPart") then
                    table.insert(targets, model)
                end
            end
        end
        return targets
    end
    for _, model in ipairs(alive:GetChildren()) do
        if model:IsA("Model") and model ~= player.Character then
            local hum = model:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 and model:FindFirstChild("HumanoidRootPart") then
                table.insert(targets, model)
            end
        end
    end
    return targets
end

function ESP:CreateESP(npc)
    if self.espObjects[npc] then return end
    if not npc:FindFirstChild("HumanoidRootPart") then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "CyberHighlight"
    highlight.Adornee = npc
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = npc
    self.espObjects[npc] = highlight
end

function ESP:RemoveESP(npc)
    if self.espObjects[npc] then
        self.espObjects[npc]:Destroy()
        self.espObjects[npc] = nil
    end
end

function ESP:ClearAllESP()
    for _, esp in pairs(self.espObjects) do
        if esp then esp:Destroy() end
    end
    table.clear(self.espObjects)
end

function ESP:CreateTracer(npc)
    if self.tracerLines[npc] then return end
    if not npc:FindFirstChild("HumanoidRootPart") then return end
    local line = Drawing.new("Line")
    line.Visible = true
    line.Color = Color3.new(0, 1, 0)
    line.Thickness = 2
    line.Transparency = 0.7
    self.tracerLines[npc] = line
end

function ESP:UpdateTracers()
    if not Core:GetFlag("TracersEnabled", false) then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local screenSize = cam.ViewportSize
    local centerX = screenSize.X / 2
    local centerY = screenSize.Y
    for npc, line in pairs(self.tracerLines) do
        if npc and npc.Parent then
            local npcRoot = npc:FindFirstChild("HumanoidRootPart")
            if npcRoot then
                local npcPos, onScreen = cam:WorldToViewportPoint(npcRoot.Position)
                if onScreen then
                    line.From = Vector2.new(centerX, centerY)
                    line.To = Vector2.new(npcPos.X, npcPos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

function ESP:RemoveTracer(npc)
    if self.tracerLines[npc] then
        self.tracerLines[npc]:Remove()
        self.tracerLines[npc] = nil
    end
end

function ESP:ClearAllTracers()
    for _, line in pairs(self.tracerLines) do
        if line then line:Remove() end
    end
    table.clear(self.tracerLines)
end

function ESP:CreateHealthBar(npc)
    if self.healthBarObjects[npc] then return end
    local npcRoot = npc:FindFirstChild("HumanoidRootPart")
    local npcHum = npc:FindFirstChild("Humanoid")
    if not npcRoot or not npcHum then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CyberHealthBar"
    billboard.Adornee = npcRoot
    billboard.Size = UDim2.new(4, 0, 0.5, 0)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = npc
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    bg.BorderSizePixel = 0
    bg.Parent = billboard
    local bar = Instance.new("Frame")
    bar.Name = "HealthBar"
    bar.Size = UDim2.new(npcHum.Health / npcHum.MaxHealth, 0, 1, 0)
    bar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    bar.BorderSizePixel = 0
    bar.Parent = bg
    local txt = Instance.new("TextLabel")
    txt.Name = "HealthText"
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = math.floor(npcHum.Health) .. "/" .. math.floor(npcHum.MaxHealth)
    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
    txt.TextScaled = true
    txt.Font = Enum.Font.GothamBold
    txt.Parent = bg
    local c1 = Instance.new("UICorner")
    c1.CornerRadius = UDim.new(0, 4)
    c1.Parent = bg
    local c2 = Instance.new("UICorner")
    c2.CornerRadius = UDim.new(0, 4)
    c2.Parent = bar
    self.healthBarObjects[npc] = billboard
end

function ESP:UpdateHealthBar(npc)
    local gui = self.healthBarObjects[npc]
    if not gui then return end
    local npcHum = npc:FindFirstChild("Humanoid")
    if not npcHum then return end
    local frame = gui:FindFirstChild("Frame")
    local bar = frame and frame:FindFirstChild("HealthBar")
    local txt = frame and frame:FindFirstChild("HealthText")
    if not bar or not txt then return end
    local pct = npcHum.Health / npcHum.MaxHealth
    bar.Size = UDim2.new(pct, 0, 1, 0)
    txt.Text = math.floor(npcHum.Health) .. "/" .. math.floor(npcHum.MaxHealth)
    if pct > 0.5 then
        bar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    elseif pct > 0.25 then
        bar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
    else
        bar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    end
end

function ESP:RemoveHealthBar(npc)
    if self.healthBarObjects[npc] then
        self.healthBarObjects[npc]:Destroy()
        self.healthBarObjects[npc] = nil
    end
end

function ESP:ClearAllHealthBars()
    for _, gui in pairs(self.healthBarObjects) do
        if gui then gui:Destroy() end
    end
    table.clear(self.healthBarObjects)
end

function ESP:UpdatePlayerESP()
    if not Core:GetFlag("PlayerESPEnabled", false) then
        for _, esp in pairs(self.playerESPObjects) do
            if esp then esp:Destroy() end
        end
        table.clear(self.playerESPObjects)
        return
    end
    for _, otherPlayer in ipairs(Core.Services.Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local char = otherPlayer.Character
            if char and not self.playerESPObjects[otherPlayer] then
                local hl = Instance.new("Highlight")
                hl.Name = "PlayerHighlight"
                hl.Adornee = char
                hl.FillColor = Color3.fromRGB(0, 255, 255)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.7
                hl.OutlineTransparency = 0
                hl.Parent = char
                self.playerESPObjects[otherPlayer] = hl
            end
        end
    end
end

function ESP:CreateFOVCircle()
    if self.fovDrawingCircle then return end
    local c = Drawing.new("Circle")
    c.Visible = true
    c.Thickness = 2
    c.Color = Color3.new(1, 1, 1)
    c.Transparency = 0.7
    c.NumSides = 60
    c.Radius = 150
    c.Filled = false
    self.fovDrawingCircle = c
end

function ESP:UpdateFOVCircle()
    if not Core:GetFlag("FOVEnabled", false) or not self.fovDrawingCircle then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local sz = cam.ViewportSize
    self.fovDrawingCircle.Position = Vector2.new(sz.X / 2, sz.Y / 2)
    self.fovDrawingCircle.Visible = true
end

function ESP:RemoveFOVCircle()
    if self.fovDrawingCircle then
        self.fovDrawingCircle:Remove()
        self.fovDrawingCircle = nil
    end
end

function ESP:UpdateVisuals()
    if not (Core:GetFlag("ESPEnabled", false) or Core:GetFlag("TracersEnabled", false) or Core:GetFlag("HealthBarsEnabled", false)) then
        return
    end
    local targets = self:GetNPCTargets()
    for _, npc in ipairs(targets) do
        if Core:GetFlag("ESPEnabled", false) then
            self:CreateESP(npc)
        else
            self:RemoveESP(npc)
        end
        if Core:GetFlag("TracersEnabled", false) then
            self:CreateTracer(npc)
        else
            self:RemoveTracer(npc)
        end
        if Core:GetFlag("HealthBarsEnabled", false) then
            self:CreateHealthBar(npc)
            self:UpdateHealthBar(npc)
        else
            self:RemoveHealthBar(npc)
        end
    end
    local existingNPCs = {}
    for _, npc in ipairs(targets) do
        existingNPCs[npc] = true
    end
    for npc, _ in pairs(self.espObjects) do
        if not existingNPCs[npc] then
            self:RemoveESP(npc)
        end
    end
    for npc, _ in pairs(self.tracerLines) do
        if not existingNPCs[npc] then
            self:RemoveTracer(npc)
        end
    end
    for npc, _ in pairs(self.healthBarObjects) do
        if not existingNPCs[npc] then
            self:RemoveHealthBar(npc)
        end
    end
end

function ESP:UpdateTracersAndFOV()
    if Core:GetFlag("TracersEnabled", false) then
        self:UpdateTracers()
    end
    if Core:GetFlag("FOVEnabled", false) then
        if not self.fovDrawingCircle then
            self:CreateFOVCircle()
        end
        self:UpdateFOVCircle()
    else
        self:RemoveFOVCircle()
    end
end

Core:RegisterModule("ESP", ESP)
