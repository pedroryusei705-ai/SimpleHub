        Surface = 0.75,
        SurfaceLight = 0.60,
        Card = 0.70,
    }
}

function Theme:ApplyCard(frame)
    frame.BackgroundColor3 = self.Colors.Surface
    frame.BackgroundTransparency = self.Transparency.Card
    frame.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = frame
    local stroke = Instance.new("UIStroke")
    stroke.Color = self.Colors.Stroke
    stroke.Thickness = 1.5
    stroke.Transparency = 0.3
    stroke.Parent = frame
    return frame
end

function Theme:ApplyButton(button, color)
    button.BackgroundColor3 = color or self.Colors.Primary
    button.BackgroundTransparency = 0.2
    button.TextColor3 = self.Colors.Text
    button.Font = self.Fonts.Bold
    button.TextSize = 12
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = button
    button.MouseEnter:Connect(function()
        self:Tween(button, { BackgroundTransparency = 0.05 }, 0.15)
    end)
    button.MouseLeave:Connect(function()
        self:Tween(button, { BackgroundTransparency = 0.2 }, 0.15)
    end)
    return button
end

function Theme:Tween(object, properties, duration)
    local tweenInfo = TweenInfo.new(
        duration or self.Animations.Duration,
        self.Animations.EasingStyle,
        self.Animations.EasingDirection
    )
    local tween = Core.Services.TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

