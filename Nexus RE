local TargetManager = {}

local npcList = {}
local lastScan = 0
local SCAN_INTERVAL = 0.15
local MAX_DISTANCE = 1000
local currentTarget = nil
local rootCache = nil

local function getPlayerRoot()
    local char = player.Character
    if not char then return nil end
    if not rootCache or rootCache.Parent ~= char then
        rootCache = char:FindFirstChild("HumanoidRootPart")
    end
    return rootCache
end

function TargetManager:update()
    local root = getPlayerRoot()
    if not root then
        table.clear(npcList)
        currentTarget = nil
        return
    end

    table.clear(npcList)
    local alive = workspace:FindFirstChild("Alive")
    local models
    if alive then
        models = alive:GetChildren()
    else
        models = workspace:GetDescendants()
    end

    for _, model in ipairs(models) do
        if model:IsA("Model") and model ~= player.Character then
            local hum = model:FindFirstChild("Humanoid")
            local modelRoot = model:FindFirstChild("HumanoidRootPart")
            if hum and modelRoot and hum.Health > 0 then
                local dist = (root.Position - modelRoot.Position).Magnitude
                if dist <= MAX_DISTANCE then
                    table.insert(npcList, { model = model, root = modelRoot, humanoid = hum, distance = dist })
                end
            end
        end
    end

    table.sort(npcList, function(a, b) return a.distance < b.distance end)
    currentTarget = #npcList > 0 and npcList[1].model or nil
end

function TargetManager:getTarget()
    local now = tick()
    if now - lastScan > SCAN_INTERVAL then
        self:update()
        lastScan = now
    end
    return currentTarget
end

function TargetManager:getClosestInfo()
    self:getTarget()
    return #npcList > 0 and npcList[1] or nil
end

