        Success = Color3.fromRGB(100, 220, 150),
        Warning = Color3.fromRGB(255, 200, 80),
        Danger = Color3.fromRGB(230, 80, 100),
        Stroke = Color3.fromRGB(120, 80, 200),
    },
    Fonts = {
        Default = Enum.Font.Gotham,
        Bold = Enum.Font.GothamBold,
        Mono = Enum.Font.SourceSans,
    },
    Sizes = {
        Padding = 8,
        CornerRadius = 10,
        ToggleWidth = 38,
