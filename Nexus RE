local Visual = {}

local originalFogStart = nil
local originalFogEnd = nil
local originalBrightness = nil
local originalAmbient = nil
local originalOutdoorAmbient = nil

function Visual:Init()
    local Lighting = Core.Services.Lighting
    originalFogStart = Lighting.FogStart
    originalFogEnd = Lighting.FogEnd
    originalBrightness = Lighting.Brightness
    originalAmbient = Lighting.Ambient
    originalOutdoorAmbient = Lighting.OutdoorAmbient

    -- Escuta mudanças nas flags
    Core:Connect("FlagChanged", function(flag, value)
        if flag == "FullBright" then
            self:SetFullBright(value)
        elseif flag == "RemoveFog" then
            self:SetFog(value)
        elseif flag == "NoClip" then
            self:ApplyNoClip(value)
        end
    end)

    -- Aplica estados iniciais
    self:SetFullBright(Core:GetFlag("FullBright", false))
    self:SetFog(Core:GetFlag("RemoveFog", false))
    self:ApplyNoClip(Core:GetFlag("NoClip", false))

    -- Loop para manter NoClip ativo (caso o personagem mude ou partes sejam adicionadas)
    Core.Connections.NoClip = Core.Services.RunService.Heartbeat:Connect(function()
        if Core:GetFlag("NoClip", false) then
            self:ApplyNoClip(true)
        end
    end)

    -- Reaplicar NoClip quando o personagem mudar
    Core.Services.Players.LocalPlayer.CharacterAdded:Connect(function()
        local noClipEnabled = Core:GetFlag("NoClip", false)
        self:ApplyNoClip(noClipEnabled)
    end)
end

function Visual:SetFullBright(enabled)
    local Lighting = Core.Services.Lighting
    if enabled then
        Lighting.Brightness = 10
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    else
        Lighting.Brightness = originalBrightness or 2
        Lighting.Ambient = originalAmbient or Color3.fromRGB(127, 127, 127)
        Lighting.OutdoorAmbient = originalOutdoorAmbient or Color3.fromRGB(127, 127, 127)
    end
end

function Visual:SetFog(enabled)
    local Lighting = Core.Services.Lighting
    if enabled then
        Lighting.FogStart = 0
        Lighting.FogEnd = 1000000
    else
        Lighting.FogStart = originalFogStart or 0
        Lighting.FogEnd = originalFogEnd or 1000
    end
end

-- Função que aplica ou remove NoClip
function Visual:ApplyNoClip(enabled)
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

