local ConfigManager = (function()
	local Services = Core.Services
	local CONFIG = Core.CONFIG
	local State = Core.State
	local Http = Services.HttpService

	local folder = CONFIG.CONFIG_FOLDER

	local function hasFileFunctions()
		return type(writefile) == "function" and type(readfile) == "function"
	end

	if not hasFileFunctions() then
		warn("[CyberHub] Funções de arquivo não disponíveis. Configurações não serão salvas.")
		return {
			saveConfig = function() return false end,
			loadConfig = function() return false end,
			listConfigs = function() return {} end,
			deleteConfig = function() return false end,
			overwriteConfig = function() return false end,
			setAutoload = function() end,
			getAutoload = function() return nil end,
			loadAutoload = function() end,
		}
	end

	if not isfolder(folder) then
		local success, err = pcall(makefolder, folder)
		if not success then
			warn("[CyberHub] Não foi possível criar a pasta de configurações: " .. tostring(err))
		end
	end

	local function saveConfig(name)
		local data = {
			autofarmEnabled=State.autofarmEnabled,
			autofarmMode=State.autofarmMode,
			autofarmDistance=State.autofarmDistance,
			lockOnEnabled=State.lockOnEnabled,
			autoAttackEnabled=State.autoAttackEnabled,
			speedEnabled=State.speedEnabled,
			speedValue=State.speedValue,
			infiniteJumpEnabled=State.infiniteJumpEnabled,
			noClipEnabled=State.noClipEnabled,
			espEnabled=State.espEnabled,
			tracersEnabled=State.tracersEnabled,
			healthBarsEnabled=State.healthBarsEnabled,
			playerESPEnabled=State.playerESPEnabled,
			fovEnabled=State.fovEnabled,
			offsetX=State.offsetX,
			offsetY=State.offsetY,
			offsetZ=State.offsetZ,
			playerFarmEnabled=State.playerFarmEnabled,
			bossFarmEnabled=State.bossFarmEnabled,
			autoBossChest=State.autoBossChest,
			autoEatHollow=State.autoEatHollow,
			autoEquipWeapon=State.autoEquipWeapon,
			autoGrip=State.autoGrip,
			resShikaiVolt=State.resShikaiVolt,
			killAura=State.killAura,
			autoCriticalAura=State.autoCriticalAura,
		}
		local path = folder.."/"..name..".json"
		local success, err = pcall(writefile, path, Http:JSONEncode(data))
		if not success then
			warn("[CyberHub] Erro ao salvar config '"..name.."': "..tostring(err))
			return false
		end
		return true
	end

	local function loadConfig(name)
		local path = folder.."/"..name..".json"
		if not isfile(path) then return false end
		local content, err = pcall(readfile, path)
		if not content then
			warn("[CyberHub] Erro ao ler config '"..name.."': "..tostring(err))
			return false
		end
		local decoded = Http:JSONDecode(content)
		if not decoded then return false end
		for k,v in pairs(decoded) do
			if State[k] ~= nil then State[k] = v end
		end
		if GUI and GUI.refreshToggles then GUI.refreshToggles() end
		return true
	end

	local function listConfigs()
		local files = listfiles(folder)
		local names = {}
		for _,file in ipairs(files) do
			local name = file:match(".+/([^/]+)%.json$")
			if name then table.insert(names, name) end
		end
		table.sort(names)
		return names
	end

	local function deleteConfig(name)
		local path = folder.."/"..name..".json"
		if isfile(path) then
			pcall(delfile, path)
			return true
		end
		return false
	end

	local function overwriteConfig(name)
		return saveConfig(name)
	end

	local autoloadFile = folder.."/autoload.txt"
	local function setAutoload(name)
		pcall(writefile, autoloadFile, name)
	end
	local function getAutoload()
		if isfile(autoloadFile) then
			return pcall(readfile, autoloadFile) and readfile(autoloadFile) or nil
		end
		return nil
	end
	local function loadAutoload()
		local name = getAutoload()
		if name then loadConfig(name) end
	end

	return {
		saveConfig=saveConfig,
		loadConfig=loadConfig,
		listConfigs=listConfigs,
		deleteConfig=deleteConfig,
		overwriteConfig=overwriteConfig,
		setAutoload=setAutoload,
		getAutoload=getAutoload,
		loadAutoload=loadAutoload,
	}
end)()

