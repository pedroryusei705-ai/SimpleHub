			end)
		end

		-- Registro de toggles para refresh
		toggleRefs = {
			autofarmEnabled={bg=mobFarmBg, circle=mobFarmCircle},
			lockOnEnabled={bg=targetMobBg, circle=targetMobCircle},
			autoAttackEnabled={bg=killAuraBg, circle=killAuraCircle},
			playerFarmEnabled={bg=targetPlayerBg, circle=targetPlayerCircle},
			bossFarmEnabled={bg=bossFarmBg, circle=bossFarmCircle},
			autoBossChest={bg=autoBossChestBg, circle=autoBossChestCircle},
			autoEatHollow={bg=autoEatHollowBg, circle=autoEatHollowCircle},
			autoEquipWeapon={bg=autoEquipBg, circle=autoEquipCircle},
			autoGrip={bg=autoGripBg, circle=autoGripCircle},
			resShikaiVolt={bg=resShikaiBg, circle=resShikaiCircle},
			autoCriticalAura={bg=autoCriticalBg, circle=autoCriticalCircle},
			sellRarities={bg=sellRaritiesBg, circle=sellRaritiesCircle},
			items={bg=itemsBg, circle=itemsCircle},
			skills={bg=skillsBg, circle=skillsCircle},
		}

		screenGui.Destroying:Connect(function()
			Utils.cleanAllConnections()
			ESP.clearAllESP(); ESP.clearAllTracers(); ESP.clearAllHealthBars(); ESP.removeFOVCircle()
			for _,esp in pairs(State.playerESPObjects) do if esp then esp:Destroy() end end
			Combat.stopAutoAttack()
		end)

		return {
			screenGui=screenGui,
			mainFrame=mainFrame,
			ToggleFunctions=ToggleFunctions,
			refreshToggles=function()
				for k,v in pairs(toggleRefs) do
					if State[k] ~= nil then Utils.animateToggle(v.bg, v.circle, State[k]) end
				end
			end
		}
	end

	return { build=build, getToggleFunctions=function() return ToggleFunctions end }
end)()

