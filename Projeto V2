-- 5. CONFIG MANAGER
-- =====================================================
local ConfigManager = {
    Folder = "RyuHubConfigs",
    AutoLoadFile = "autoload.txt",
}

local function getPath(name)
    return ConfigManager.Folder .. "/" .. name .. ".json"
end

function ConfigManager:Init()
    if not isfolder(self.Folder) then
        makefolder(self.Folder)
    end
end

function ConfigManager:Save(name)
    local data = {}
    for flag, value in pairs(Core.Flags) do
        data[flag] = value
    end
    local json = Core.Services.HttpService:JSONEncode(data)
    local success, err = pcall(writefile, getPath(name), json)
    if not success then
        warn("[Config] Erro ao salvar: " .. tostring(err))
        return false
    end
    return true
end

function ConfigManager:Load(name)
    local path = getPath(name)
    if not isfile(path) then return false end
    local success, content = pcall(readfile, path)
    if not success then return false end
    local data = Core.Services.HttpService:JSONDecode(content)
    if not data then return false end
    for flag, value in pairs(data) do
        if Core.Flags[flag] ~= nil then
            Core:SetFlag(flag, value)
        end
    end
    return true
end

function ConfigManager:List()
    local files = listfiles(self.Folder)
    local names = {}
    for _, file in ipairs(files) do
        local name = file:match(".+/([^/]+)%.json$")
        if name then table.insert(names, name) end
    end
    table.sort(names)
    return names
end

function ConfigManager:Delete(name)
    pcall(delfile, getPath(name))
end

function ConfigManager:SetAutoload(name)
    pcall(writefile, self.Folder .. "/" .. self.AutoLoadFile, name)
end

function ConfigManager:GetAutoload()
    if isfile(self.Folder .. "/" .. self.AutoLoadFile) then
        return readfile(self.Folder .. "/" .. self.AutoLoadFile)
    end
    return nil
end

function ConfigManager:LoadAutoload()
    local name = self:GetAutoload()
    if name then self:Load(name) end
end

