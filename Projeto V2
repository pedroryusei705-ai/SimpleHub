-- Toggle
function Widgets:Toggle(parent, config)
    local flag = config.flag
    local label = config.label
    local desc = config.desc
    local default = config.default or false

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, desc and 55 or 40)
    container.BackgroundColor3 = Theme.Colors.Surface
    container.BorderSizePixel = 0
    container.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
    corner.Parent = container

    local labelObj = Instance.new("TextLabel")
    labelObj.Size = UDim2.new(0.7, -10, 0, 20)
    labelObj.Position = UDim2.new(0, 10, 0, desc and 8 or 10)
    labelObj.BackgroundTransparency = 1
    labelObj.Text = label
    labelObj.Font = Theme.Fonts.Default
    labelObj.TextSize = 12
    labelObj.TextColor3 = Theme.Colors.Text
    labelObj.TextXAlignment = Enum.TextXAlignment.Left
    labelObj.Parent = container

    if desc then
        local descObj = Instance.new("TextLabel")
        descObj.Size = UDim2.new(1, -20, 0, 18)
        descObj.Position = UDim2.new(0, 10, 0, 28)
        descObj.BackgroundTransparency = 1
        descObj.Text = desc
        descObj.Font = Theme.Fonts.Default
        descObj.TextSize = 9
        descObj.TextColor3 = Theme.Colors.TextMuted
        descObj.TextWrapped = true
        descObj.Parent = container
    end

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(0, Theme.Sizes.ToggleWidth, 0, Theme.Sizes.ToggleHeight)
    bg.Position = UDim2.new(1, -(Theme.Sizes.ToggleWidth + 7), 0, 10)
    bg.BackgroundColor3 = Theme.Colors.SurfaceLight
    bg.BorderSizePixel = 0
    bg.Parent = container
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(1, 0)
    bgCorner.Parent = bg

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = Theme.Colors.Text
    circle.BorderSizePixel = 0
    circle.Parent = bg
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = bg

    local function setState(value)
        Core:SetFlag(flag, value)
        Theme:ApplyToggle(bg, circle, value)
    end

    local initial = Core:GetFlag(flag, default)
    setState(initial)

    btn.MouseButton1Click:Connect(function()
        setState(not Core:GetFlag(flag))
    end)

    local widget = {
        Update = function(value)
            Theme:ApplyToggle(bg, circle, value)
        end
    }
    Core:RegisterWidget(flag, widget)

    return container, widget
end

-- Slider
function Widgets:Slider(parent, config)
    local flag = config.flag
    local label = config.label
    local desc = config.desc
    local min = config.min or 0
    local max = config.max or 100
    local default = config.default or 50
    local precision = config.precision or 1

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, desc and 70 or 55)
    container.BackgroundColor3 = Theme.Colors.Surface
    container.BorderSizePixel = 0
    container.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
    corner.Parent = container

    local labelObj = Instance.new("TextLabel")
    labelObj.Size = UDim2.new(0.7, -10, 0, 20)
    labelObj.Position = UDim2.new(0, 10, 0, desc and 8 or 10)
    labelObj.BackgroundTransparency = 1
    labelObj.Text = label
    labelObj.Font = Theme.Fonts.Default
    labelObj.TextSize = 12
    labelObj.TextColor3 = Theme.Colors.Text
    labelObj.TextXAlignment = Enum.TextXAlignment.Left
    labelObj.Parent = container

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.3, -10, 0, 20)
    valueLabel.Position = UDim2.new(0.7, 0, 0, desc and 8 or 10)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default)
    valueLabel.Font = Theme.Fonts.Default
    valueLabel.TextSize = 12
    valueLabel.TextColor3 = Theme.Colors.TextDim
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = container

    if desc then
        local descObj = Instance.new("TextLabel")
        descObj.Size = UDim2.new(1, -20, 0, 18)
        descObj.Position = UDim2.new(0, 10, 0, 28)
        descObj.BackgroundTransparency = 1
        descObj.Text = desc
        descObj.Font = Theme.Fonts.Default
        descObj.TextSize = 9
        descObj.TextColor3 = Theme.Colors.TextMuted
        descObj.TextWrapped = true
        descObj.Parent = container
    end

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -20, 0, Theme.Sizes.SliderHeight)
    track.Position = UDim2.new(0, 10, 1, -(Theme.Sizes.SliderHeight + 8))
    track.BackgroundColor3 = Theme.Colors.SurfaceLight
    track.BorderSizePixel = 0
    track.Parent = container
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0.5, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Colors.Primary
    fill.BorderSizePixel = 0
    fill.Parent = track
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill

    local function setValue(value)
        local clamped = math.clamp(value, min, max)
        clamped = math.floor(clamped / precision) * precision
        Core:SetFlag(flag, clamped)
        Theme:ApplySlider(track, fill, clamped, min, max)
        valueLabel.Text = tostring(clamped)
    end

    local initial = Core:GetFlag(flag, default)
    setValue(initial)

    local sliderBtn = Instance.new("TextButton")
    sliderBtn.Size = UDim2.new(1, 0, 1, 0)
    sliderBtn.BackgroundTransparency = 1
    sliderBtn.Text = ""
    sliderBtn.Parent = track

    local dragging = false
    sliderBtn.MouseButton1Down:Connect(function()
        dragging = true
    end)
    sliderBtn.MouseButton1Up:Connect(function()
        dragging = false
    end)
    sliderBtn.MouseLeave:Connect(function()
        dragging = false
    end)

    Core.Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local absPos = track.AbsolutePosition
            local absSize = track.AbsoluteSize
            local mouseX = input.Position.X
            local percent = math.clamp((mouseX - absPos.X) / absSize.X, 0, 1)
            local value = min + (max - min) * percent
            setValue(value)
        end
    end)

    local widget = {
        Update = function(value)
            Theme:ApplySlider(track, fill, value, min, max)
            valueLabel.Text = tostring(value)
        end
    }
    Core:RegisterWidget(flag, widget)

    return container, widget
end

