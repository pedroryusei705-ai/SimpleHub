local Window = {}

function Window:CreateWindow(config)
    local title = config.title or "RyuHub"
    local size = config.size or Vector2.new(600, 700)
    local icon = config.icon or "★"

    local gui = Instance.new("ScreenGui")
    gui.Name = "RyuHub"
    gui.ResetOnSpawn = false
    gui.Parent = Core.Services.CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, size.X, 0, size.Y)
    frame.Position = UDim2.new(0, 20, 0.5, -size.Y/2)
    frame.BackgroundColor3 = Theme.Colors.Background
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    Theme:ApplyCard(frame)

    -- Topbar
    local topbar = Instance.new("Frame")
    topbar.Size = UDim2.new(1, 0, 0, 35)
    topbar.BackgroundColor3 = Theme.Colors.Surface
    topbar.BorderSizePixel = 0
    topbar.Parent = frame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -40, 1, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = icon .. " " .. title
    titleLabel.Font = Theme.Fonts.Bold
    titleLabel.TextSize = 14
    titleLabel.TextColor3 = Theme.Colors.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = topbar

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 1, 0)
    closeBtn.Position = UDim2.new(1, -30, 0, 0)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.Font = Theme.Fonts.Default
    closeBtn.TextSize = 16
    closeBtn.TextColor3 = Theme.Colors.TextMuted
    closeBtn.Parent = topbar
    closeBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
        if Core.Window then Core.Window = nil end
    end)

    -- Sidebar
    local sidebar = Instance.new("Frame")
    sidebar.Size = UDim2.new(0, 45, 1, -40)
    sidebar.Position = UDim2.new(0, 5, 0, 38)
    sidebar.BackgroundColor3 = Theme.Colors.Surface
    sidebar.BorderSizePixel = 0
    sidebar.Parent = frame
    local sidebarCorner = Instance.new("UICorner")
    sidebarCorner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
    sidebarCorner.Parent = sidebar

    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.Padding = UDim.new(0, 8)
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarLayout.Parent = sidebar

    -- Content area
    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -60, 1, -40)
    content.Position = UDim2.new(0, 55, 0, 38)
    content.BackgroundTransparency = 1
    content.Parent = frame

    local pages = {}
    local pageButtons = {}

    local function createPage(name, icon)
        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.new(1, -5, 1, 0)
        page.BackgroundTransparency = 1
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 100)
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.Visible = false
        page.Parent = content

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 8)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = page

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 35, 0, 35)
        btn.BackgroundColor3 = Theme.Colors.SurfaceLight
        btn.Text = icon or "•"
        btn.Font = Theme.Fonts.Bold
        btn.TextSize = 16
        btn.TextColor3 = Theme.Colors.TextMuted
        btn.BorderSizePixel = 0
        btn.Parent = sidebar
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
        corner.Parent = btn

        table.insert(pages, page)
        table.insert(pageButtons, btn)

        btn.MouseButton1Click:Connect(function()
            switchPage(page)
        end)

        return page
    end

    local function switchPage(targetPage)
        for _, p in ipairs(pages) do
            p.Visible = false
        end
        for _, b in ipairs(pageButtons) do
            b.BackgroundColor3 = Theme.Colors.SurfaceLight
            b.TextColor3 = Theme.Colors.TextMuted
        end
        targetPage.Visible = true
        for i, p in ipairs(pages) do
            if p == targetPage then
                pageButtons[i].BackgroundColor3 = Theme.Colors.Primary
                pageButtons[i].TextColor3 = Theme.Colors.Text
            end
        end
    end

    local windowObj = {
        Frame = frame,
        Gui = gui,
        CreatePage = createPage,
        SwitchPage = switchPage,
        Destroy = function()
            gui:Destroy()
            if Core.Window == windowObj then Core.Window = nil end
        end
    }

    Core.Window = windowObj
    return windowObj
end

