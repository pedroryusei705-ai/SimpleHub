        self.espObjects[npc]:Destroy()
        self.espObjects[npc] = nil
    end
end

function ESP:clearAllESP()
    for _, esp in pairs(self.espObjects) do
        if esp then esp:Destroy() end
    end
    table.clear(self.espObjects)
end

function ESP:createTracer(npc)
    if self.tracerLines[npc] then return end
    if not npc:FindFirstChild("HumanoidRootPart") then return end
    local line = Drawing.new("Line")
    line.Visible = true
    line.Color = Color3.new(0, 1, 0)
    line.Thickness = 2
    line.Transparency = 0.7
    self.tracerLines[npc] = line
end

function ESP:updateTracers()
    if not Core:GetFlag("Tracers") then return end
    local cam = Core.Runtime.currentCamera or workspace.CurrentCamera
    if not cam then return end
    local screenSize = cam.ViewportSize
    local centerX = screenSize.X / 2
    local centerY = screenSize.Y
    for npc, line in pairs(self.tracerLines) do
        if npc and npc.Parent then
            local npcRoot = npc:FindFirstChild("HumanoidRootPart")
            if npcRoot then
                local npcPos, onScreen = cam:WorldToViewportPoint(npcRoot.Position)
                if onScreen then
                    line.From = Vector2.new(centerX, centerY)
                    line.To = Vector2.new(npcPos.X, npcPos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

function ESP:removeTracer(npc)
    if self.tracerLines[npc] then
        self.tracerLines[npc]:Remove()
        self.tracerLines[npc] = nil
    end
end

function ESP:clearAllTracers()
    for _, line in pairs(self.tracerLines) do
        if line then line:Remove() end
    end
    table.clear(self.tracerLines)
end

function ESP:createHealthBar(npc)
    if self.healthBarObjects[npc] then return end
    local npcRoot = npc:FindFirstChild("HumanoidRootPart")
    local npcHum = npc:FindFirstChild("Humanoid")
    if not npcRoot or not npcHum then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CyberHealthBar"
    billboard.Adornee = npcRoot
    billboard.Size = UDim2.new(4, 0, 0.5, 0)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = npc
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    bg.BorderSizePixel = 0
    bg.Parent = billboard
    local bar = Instance.new("Frame")
    bar.Name = "HealthBar"
    bar.Size = UDim2.new(npcHum.Health / npcHum.MaxHealth, 0, 1, 0)
    bar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    bar.BorderSizePixel = 0
    bar.Parent = bg
    local txt = Instance.new("TextLabel")
    txt.Name = "HealthText"
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = math.floor(npcHum.Health) .. "/" .. math.floor(npcHum.MaxHealth)
    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
    txt.TextScaled = true
    txt.Font = Enum.Font.GothamBold
    txt.Parent = bg
    local c1 = Instance.new("UICorner"); c1.CornerRadius = UDim.new(0, 4); c1.Parent = bg
    local c2 = Instance.new("UICorner"); c2.CornerRadius = UDim.new(0, 4); c2.Parent = bar
    self.healthBarObjects[npc] = billboard
end

function ESP:updateHealthBar(npc)
    local gui = self.healthBarObjects[npc]
    if not gui then return end
    local npcHum = npc:FindFirstChild("Humanoid")
    if not npcHum then return end
    local frame = gui:FindFirstChild("Frame")
    local bar = frame and frame:FindFirstChild("HealthBar")
    local txt = frame and frame:FindFirstChild("HealthText")
    if not bar or not txt then return end
    local pct = npcHum.Health / npcHum.MaxHealth
    bar.Size = UDim2.new(pct, 0, 1, 0)
    txt.Text = math.floor(npcHum.Health) .. "/" .. math.floor(npcHum.MaxHealth)
    if pct > 0.5 then
        bar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    elseif pct > 0.25 then
        bar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
    else
        bar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    end
end

function ESP:removeHealthBar(npc)
    if self.healthBarObjects[npc] then
        self.healthBarObjects[npc]:Destroy()
        self.healthBarObjects[npc] = nil
    end
end

function ESP:clearAllHealthBars()
    for _, gui in pairs(self.healthBarObjects) do
        if gui then gui:Destroy() end
    end
    table.clear(self.healthBarObjects)
end

function ESP:updatePlayerESP()
    local player = Core.Services.Players.LocalPlayer
    if not Core:GetFlag("PlayerESP") then
        for _, esp in pairs(self.playerESPObjects) do
            if esp then esp:Destroy() end
        end
        table.clear(self.playerESPObjects)
        return
    end
    for _, otherPlayer in ipairs(Core.Services.Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local char = otherPlayer.Character
            if not self.playerESPObjects[otherPlayer] then
                local hl = Instance.new("Highlight")
                hl.Name = "PlayerHighlight"
                hl.Adornee = char
                hl.FillColor = Color3.fromRGB(0, 255, 255)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.7
                hl.OutlineTransparency = 0
                hl.Parent = char
                self.playerESPObjects[otherPlayer] = hl
            end
        end
    end
end

function ESP:createFOVCircle()
    if self.fovDrawingCircle then return end
    local c = Drawing.new("Circle")
    c.Visible = true
    c.Thickness = 2
    c.Color = Color3.new(1, 1, 1)
    c.Transparency = 0.7
    c.NumSides = 60
    c.Radius = 150
    c.Filled = false
    self.fovDrawingCircle = c
end

function ESP:updateFOVCircle()
    if not Core:GetFlag("FOV") or not self.fovDrawingCircle then return end
    local cam = Core.Runtime.currentCamera or workspace.CurrentCamera
    if not cam then return end
    local sz = cam.ViewportSize
    self.fovDrawingCircle.Position = Vector2.new(sz.X / 2, sz.Y / 2)
    self.fovDrawingCircle.Visible = true
end

function ESP:removeFOVCircle()
    if self.fovDrawingCircle then
        self.fovDrawingCircle:Remove()
        self.fovDrawingCircle = nil
    end
end

function ESP:updateVisuals()
    if not (Core:GetFlag("ESP") or Core:GetFlag("Tracers") or Core:GetFlag("HealthBars")) then return end
    local player = Core.Services.Players.LocalPlayer
    local folder = Core.CONFIG.VISUAL_NPC_FOLDER
    if not folder then return end
    for _, npc in ipairs(folder:GetChildren()) do
        if npc:IsA("Model") and npc ~= player.Character then
            local hum = npc:FindFirstChild("Humanoid")
            local npcRoot = npc:FindFirstChild("HumanoidRootPart")
            if hum and npcRoot and hum.Health > 0 then
                if Core:GetFlag("ESP") then self:createESP(npc) else self:removeESP(npc) end
                if Core:GetFlag("Tracers") then self:createTracer(npc) else self:removeTracer(npc) end
                if Core:GetFlag("HealthBars") then
                    self:createHealthBar(npc)
                    self:updateHealthBar(npc)
                else
                    self:removeHealthBar(npc)
                end
            else
                self:removeESP(npc); self:removeTracer(npc); self:removeHealthBar(npc)
            end
        end
    end
end

function ESP:updateTracersAndFOV()
    if Core:GetFlag("Tracers") then self:updateTracers() end
    if Core:GetFlag("FOV") then self:updateFOVCircle() end
end

