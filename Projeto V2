local Theme = {
    Colors = {
        Background = Color3.fromRGB(13, 13, 18),
        Surface = Color3.fromRGB(18, 18, 25),
        SurfaceLight = Color3.fromRGB(25, 25, 35),
        Primary = Color3.fromRGB(100, 180, 255),
        PrimaryDark = Color3.fromRGB(60, 130, 200),
        Text = Color3.fromRGB(255, 255, 255),
        TextDim = Color3.fromRGB(180, 180, 200),
        TextMuted = Color3.fromRGB(120, 120, 140),
        Success = Color3.fromRGB(80, 200, 120),
        Warning = Color3.fromRGB(255, 180, 80),
        Danger = Color3.fromRGB(220, 80, 80),
    },
    Fonts = {
        Default = Enum.Font.Gotham,
        Bold = Enum.Font.GothamBold,
        Mono = Enum.Font.SourceSans,
    },
    Sizes = {
        Padding = 8,
        CornerRadius = 6,
        ToggleWidth = 38,
        ToggleHeight = 20,
        SliderHeight = 4,
        ButtonHeight = 35,
        SectionHeight = 30,
    },
    Animations = {
        Duration = 0.2,
        EasingStyle = Enum.EasingStyle.Quad,
        EasingDirection = Enum.EasingDirection.Out,
    }
}

function Theme:ApplyCard(frame)
    frame.BackgroundColor3 = self.Colors.Surface
    frame.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = frame
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 80)
    stroke.Thickness = 1
    stroke.Transparency = 0.5
    stroke.Parent = frame
    return frame
end

function Theme:ApplyButton(button, color)
    button.BackgroundColor3 = color or self.Colors.Primary
    button.TextColor3 = self.Colors.Text
    button.Font = self.Fonts.Bold
    button.TextSize = 12
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = button
    button.MouseEnter:Connect(function()
        self:Tween(button, { BackgroundTransparency = 0.2 }, 0.15)
    end)
    button.MouseLeave:Connect(function()
        self:Tween(button, { BackgroundTransparency = 0 }, 0.15)
    end)
    return button
end

function Theme:Tween(object, properties, duration)
    local tweenInfo = TweenInfo.new(duration or self.Animations.Duration,
                                   self.Animations.EasingStyle,
                                   self.Animations.EasingDirection)
    local tween = Core.Services.TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

function Theme:ApplyToggle(bg, circle, state)
    bg.BackgroundColor3 = state and self.Colors.Primary or self.Colors.SurfaceLight
    circle.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
end

function Theme:ApplySlider(track, fill, value, min, max)
    local percent = (value - min) / (max - min)
    fill.Size = UDim2.new(percent, 0, 1, 0)
end

function Theme:ApplyDropdown(button, list, selected)
    button.BackgroundColor3 = self.Colors.SurfaceLight
    button.TextColor3 = self.Colors.Text
    button.Font = self.Fonts.Default
    button.TextSize = 12
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = button
end

