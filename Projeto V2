    local dropdownList = Instance.new("Frame")
    dropdownList.Size = UDim2.new(0.45, -20, 0, 0)
    dropdownList.Position = UDim2.new(0.55, 0, 0, desc and 33 or 35)
    dropdownList.BackgroundColor3 = Theme.Colors.SurfaceLight
    dropdownList.BorderSizePixel = 0
    dropdownList.Visible = false
    dropdownList.ClipsDescendants = true
    dropdownList.Parent = container
    local listCorner = Instance.new("UICorner")
    listCorner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
    listCorner.Parent = dropdownList

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 2)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = dropdownList

    local function setValue(option)
        Core:SetFlag(flag, option)
        button.Text = option
        dropdownList.Visible = false
    end

    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, 0, 0, 25)
        optBtn.BackgroundColor3 = Theme.Colors.SurfaceLight
        optBtn.Text = opt
        optBtn.TextColor3 = Theme.Colors.Text
        optBtn.Font = Theme.Fonts.Default
        optBtn.TextSize = 12
        optBtn.BorderSizePixel = 0
        optBtn.Parent = dropdownList
        local optCorner = Instance.new("UICorner")
        optCorner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
        optCorner.Parent = optBtn
        optBtn.MouseButton1Click:Connect(function()
            setValue(opt)
        end)
    end

    button.MouseButton1Click:Connect(function()
        dropdownList.Visible = not dropdownList.Visible
        if dropdownList.Visible then
            dropdownList.Size = UDim2.new(0.45, -20, 0, #options * 27)
        else
            dropdownList.Size = UDim2.new(0.45, -20, 0, 0)
        end
    end)

    local initial = Core:GetFlag(flag, default)
    if initial then
        button.Text = initial
    end

    local widget = {
        Update = function(value)
            button.Text = value or default
        end
    }
    Core:RegisterWidget(flag, widget)

    return container, widget
end

