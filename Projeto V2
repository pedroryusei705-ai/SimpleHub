--------------------------------------------------------
-- PLAYER CACHE
--------------------------------------------------------

function Core:UpdateCharacter()

	local player = Services.Players.LocalPlayer

	self.Cache.Player = player

	self.Cache.Character = player.Character

	self.Cache.Humanoid = self.Cache.Character
		and self.Cache.Character:FindFirstChildOfClass("Humanoid")

	self.Cache.Root = self.Cache.Character
		and self.Cache.Character:FindFirstChild("HumanoidRootPart")

	self.Cache.Camera = workspace.CurrentCamera

end

Core:UpdateCharacter()

Services.Players.LocalPlayer.CharacterAdded:Connect(function()

	task.wait(.15)

	Core:UpdateCharacter()

end)
