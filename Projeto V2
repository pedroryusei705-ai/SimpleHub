-- 10. COMBAT SYSTEM (KILL AURA + AUTOFARM + LOCKON + SPEED)
-- =====================================================
local Combat = {}

function Combat:Init()
    self.autoAttackRunning = false
    self.autoAttackThread = nil
    self.attackCooldown = 0.12
    self.burstCount = 3
    self.lockedNPC = nil
    self.lockedTarget = nil

    -- Conexões principais
    Core.Connections.AutoFarm = Core.Services.RunService.Heartbeat:Connect(function()
        if Core:GetFlag("AutoFarm") then
            self:autofarmLoop()
        end
    end)

    Core.Connections.LockOn = Core.Services.RunService.RenderStepped:Connect(function()
        if Core:GetFlag("LockOn") then
            self:lockOnLoop()
        end
    end)

    Core.Connections.Speed = Core.Services.RunService.Heartbeat:Connect(function()
        if Core:GetFlag("Speed") then
            self:speedLoop()
        end
    end)

    -- Reagir a mudanças de flag para AutoAttack
    Core:Connect("FlagChanged", function(flag, value)
        if flag == "AutoAttack" then
            if value then
                self:startAutoAttack()
            else
                self:stopAutoAttack()
            end
        end
        if flag == "BurstCount" then
            self.burstCount = value
        end
    end)

    -- Inicializa valores padrão
    self.burstCount = Core:GetFlag("BurstCount", 3)
    if Core:GetFlag("AutoAttack", false) then
        self:startAutoAttack()
    end

    -- Atualiza cache de personagem ao respawnar
    Core.Services.Players.LocalPlayer.CharacterAdded:Connect(function()
        Utils:invalidateCharCache()
        task.wait(0.3)
        if Core:GetFlag("Speed") then
            -- reconectar speed loop já está ativo
        end
        if Core:GetFlag("AutoAttack") then
            self:stopAutoAttack()
            self:startAutoAttack()
        end
    end)
end

function Combat:startAutoAttack()
    if self.autoAttackThread then return end
    self.autoAttackRunning = true
    self.autoAttackThread = task.spawn(function()
        local player = Core.Services.Players.LocalPlayer
        local char = player.Character or player.CharacterAdded:Wait()
        local remote = game.ReplicatedStorage:FindFirstChild("Events") and game.ReplicatedStorage.Events:FindFirstChild("CombatEvent")
        if not remote then
            warn("CombatEvent not found")
            return
        end
        local weapon = char:FindFirstChild("FistCombat") and char.FistCombat:FindFirstChild("WeaponInfoFolder") and char.FistCombat.WeaponInfoFolder:FindFirstChild("Fist")
        if not weapon then
            warn("Weapon not found")
            return
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        while self.autoAttackRunning do
            task.wait(self.attackCooldown)
            local target = self.lockedNPC or self.lockedTarget
            if not target or not target.Parent then
                target = NPCCache:findClosest()
                self.lockedTarget = target
            end
            local burst = self.burstCount
            if burst < 1 then burst = 1 end
            if target then
                local npcRoot = target:FindFirstChild("HumanoidRootPart")
                if npcRoot then
                    local attackPos = npcRoot.Position
                    local mode = Core:GetFlag("AutoFarmMode", "Behind")
                    if mode == "Behind" then
                        local backVec = -npcRoot.CFrame.LookVector * Core:GetFlag("AutoFarmDistance", 10)
                        attackPos = npcRoot.Position + backVec + Vector3.new(0, Core.CONFIG.HEIGHT_OFFSET, 0)
                    elseif mode == "Above" then
                        attackPos = npcRoot.Position + Vector3.new(0, Core:GetFlag("AutoFarmDistance", 10), 0)
                    end
                    local cframe = CFrame.new(attackPos, npcRoot.Position)
                    for _ = 1, burst do
                        remote:FireServer(1, weapon, cframe, true, weapon)
                        remote:FireServer(2, weapon, cframe, true, weapon)
                        remote:FireServer(3, weapon, cframe, true, weapon)
                        remote:FireServer(4, weapon, cframe, true, weapon)
                    end
                end
            else
                local cframe = root.CFrame * CFrame.new(0, 0, -3)
                for _ = 1, burst do
                    remote:FireServer(1, weapon, cframe, true, weapon)
                    remote:FireServer(2, weapon, cframe, true, weapon)
                    remote:FireServer(3, weapon, cframe, true, weapon)
                    remote:FireServer(4, weapon, cframe, true, weapon)
                end
            end
        end
    end)
end

function Combat:stopAutoAttack()
    self.autoAttackRunning = false
    if self.autoAttackThread then
        task.cancel(self.autoAttackThread)
        self.autoAttackThread = nil
    end
end

function Combat:lockOnLoop()
    if not Core:GetFlag("LockOn") then return end
    local camera = Core.Runtime.currentCamera or workspace.CurrentCamera
    if not camera then return end
    local target = self.lockedTarget
    if Core:GetFlag("AutoFarm") and self.lockedNPC then target = self.lockedNPC end
    if not target or not target.Parent then
        target = NPCCache:findClosest()
        self.lockedTarget = target
    end
    if target then
        local npcRoot = target:FindFirstChild("HumanoidRootPart")
        if npcRoot then
            local currentPos = camera.CFrame.Position
            local targetPos = npcRoot.Position
            local lookAt = CFrame.new(currentPos, targetPos)
            camera.CFrame = camera.CFrame:Lerp(lookAt, 0.35)
        end
    end
end

function Combat:autofarmLoop()
    if not Core:GetFlag("AutoFarm") then return end
    local root = Utils:getCharComponents()
    if not root then return end
    if not NPCCache:isValid(self.lockedNPC) then
        self.lockedNPC = NPCCache:findClosest()
    end
    local npc = self.lockedNPC
    if not npc then return end
    local npcRoot = npc:FindFirstChild("HumanoidRootPart")
    if not npcRoot then
        self.lockedNPC = nil
        return
    end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    local dist = Core:GetFlag("AutoFarmDistance", 10)
    local mode = Core:GetFlag("AutoFarmMode", "Behind")
    if mode == "Above" then
        local targetPos = npcRoot.Position + Vector3.new(0, dist, 0)
        root.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(-90), 0, 0)
    else
        local backVec = -npcRoot.CFrame.LookVector * dist
        local upVec = Vector3.new(0, Core.CONFIG.HEIGHT_OFFSET, 0)
        local targetPos = npcRoot.Position + backVec + upVec
        root.CFrame = CFrame.new(targetPos, npcRoot.Position)
    end
end

function Combat:speedLoop()
    if not Core:GetFlag("Speed") then return end
    local root, hum = Utils:getCharComponents()
    if root and hum then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            local curY = root.AssemblyLinearVelocity.Y
            local speedVal = Core:GetFlag("SpeedValue", 50)
            root.AssemblyLinearVelocity = (moveDir.Unit * speedVal) + Vector3.new(0, curY, 0)
        end
    end
end

Core:RegisterModule("Combat", Combat)

