-- 1. CORE
-- =====================================================
local Core = {
    Services = {},
    Flags = {},
    Registry = {},
    Events = {},
    Connections = {},
    Modules = {},
    Config = {},
    Runtime = {},
}

-- Inicializa serviços
Core.Services.Players = game:GetService("Players")
Core.Services.RunService = game:GetService("RunService")
Core.Services.UserInputService = game:GetService("UserInputService")
Core.Services.CoreGui = game:GetService("CoreGui")
Core.Services.TweenService = game:GetService("TweenService")
Core.Services.HttpService = game:GetService("HttpService")
Core.Services.Lighting = game:GetService("Lighting")
Core.Services.StarterGui = game:GetService("StarterGui")

-- Funções de Flag
function Core:SetFlag(name, value)
    self.Flags[name] = value
    self:FireEvent("FlagChanged", name, value)
    if self.Registry[name] then
        for _, widget in ipairs(self.Registry[name]) do
            widget:Update(value)
        end
    end
end

function Core:GetFlag(name, default)
    if self.Flags[name] == nil then return default end
    return self.Flags[name]
end

-- Registro de widgets
function Core:RegisterWidget(name, widget)
    if not self.Registry[name] then
        self.Registry[name] = {}
    end
    table.insert(self.Registry[name], widget)
    widget:Update(self:GetFlag(name, false))
end

-- Eventos
function Core:Connect(event, callback)
    if not self.Events[event] then
        self.Events[event] = {}
    end
    table.insert(self.Events[event], callback)
end

function Core:FireEvent(event, ...)
    if self.Events[event] then
        for _, cb in ipairs(self.Events[event]) do
            task.spawn(cb, ...)
        end
    end
end

-- Registro de módulos
function Core:RegisterModule(name, module)
    self.Modules[name] = module
    module.Core = self
    if module.Init then
        module:Init()
    end
end

function Core:GetModule(name)
    return self.Modules[name]
end

-- Ciclo de vida
function Core:Destroy()
    for _, conn in pairs(self.Connections) do
        if conn.Connected then conn:Disconnect() end
    end
    table.clear(self.Connections)
    table.clear(self.Events)
    table.clear(self.Registry)
    if self.Window then
        self.Window:Destroy()
    end
end

function Core:Notify(text, duration)
    -- Implementação simples de notificação (pode ser expandida)
    local notif = Instance.new("TextLabel")
    notif.Size = UDim2.new(0, 300, 0, 40)
    notif.Position = UDim2.new(0.5, -150, 0, 10)
    notif.BackgroundColor3 = Theme.Colors.Surface
    notif.Text = text
    notif.TextColor3 = Theme.Colors.Text
    notif.Font = Theme.Fonts.Default
    notif.TextSize = 14
    notif.BorderSizePixel = 0
    Theme:ApplyCard(notif)
    notif.Parent = Core.Window and Core.Window.Gui or Core.Services.CoreGui
    task.delay(duration or 2, function()
        notif:Destroy()
    end)
end

