-- 9. TELEPORT SYSTEM
-- =====================================================
local Teleport = {}

function Teleport:Init()
    self.isTeleporting = false
end

function Teleport:ultraSmoothTeleport(targetPosition)
    if self.isTeleporting then return false end
    local root = Utils:getCharComponents()
    if not root then return false end
    self.isTeleporting = true
    local startPos = root.Position
    local distance = (targetPosition - startPos).Magnitude
    if distance < 10 then
        root.CFrame = CFrame.new(targetPosition)
        self.isTeleporting = false
        return true
    end
    local CONFIG = Core.CONFIG
    if distance > CONFIG.MAX_TELEPORT_DISTANCE then
        local direction = (targetPosition - startPos).Unit
        local numChunks = math.ceil(distance / CONFIG.MAX_TELEPORT_DISTANCE)
        for i = 1, numChunks do
            if not self.isTeleporting then break end
            local chunkTarget = (i == numChunks) and targetPosition or (startPos + direction * CONFIG.MAX_TELEPORT_DISTANCE * i)
            local chunkTime = (chunkTarget - root.Position).Magnitude / CONFIG.TELEPORT_SPEED
            local tween = Core.Services.TweenService:Create(root, TweenInfo.new(chunkTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = CFrame.new(chunkTarget) })
            tween:Play()
            tween.Completed:Wait()
            task.wait(0.1)
        end
    else
        local travelTime = distance / CONFIG.TELEPORT_SPEED
        local tween = Core.Services.TweenService:Create(root, TweenInfo.new(travelTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = CFrame.new(targetPosition) })
        tween:Play()
        tween.Completed:Wait()
    end
    self.isTeleporting = false
    return true
end

function Teleport:safeTeleportToNPC(npcName)
    local root = Utils:getCharComponents()
    if not root then return false, "Character not found" end
    local folder = Core.CONFIG.TELEPORT_NPC_FOLDER
    if not folder then return false, "Teleport folder not set" end
    for _, npc in ipairs(folder:GetChildren()) do
        if npc.Name == npcName and npc:IsA("Model") then
            local npcRoot = npc:FindFirstChild("HumanoidRootPart")
            if npcRoot then
                task.spawn(function()
                    self:ultraSmoothTeleport(npcRoot.Position + Vector3.new(0, 2, 5))
                end)
                return true, "Teleporting..."
            end
        end
    end
    return false, "NPC not found"
end

function Teleport:getNPCList()
    local list = {}
    local folder = Core.CONFIG.TELEPORT_NPC_FOLDER
    if not folder then return list end
    for _, npc in ipairs(folder:GetChildren()) do
        if npc:IsA("Model") and npc:FindFirstChild("HumanoidRootPart") and not table.find(list, npc.Name) then
            table.insert(list, npc.Name)
        end
    end
    table.sort(list)
    return list
end

Core:RegisterModule("Teleport", Teleport)

