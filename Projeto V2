local Input = {}

function Input:Init()
    local player = Core.Services.Players.LocalPlayer

    Core.Services.UserInputService.JumpRequest:Connect(function()
        if Core:GetFlag("InfiniteJump") then
            local _, hum = Utils:getCharComponents()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    Core.Services.UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end

        if input.KeyCode == Enum.KeyCode.F1 then
            local visible = not Core:GetFlag("GuiVisible", true)
            Core:SetFlag("GuiVisible", visible)
            if Core.Window and Core.Window.Frame then
                Core.Window.Frame.Visible = visible
            end
        elseif input.KeyCode == Enum.KeyCode.KeypadOne then
            local newVal = not Core:GetFlag("AutoAttack")
            Core:SetFlag("AutoAttack", newVal)
            if newVal then Combat:startAutoAttack() else Combat:stopAutoAttack() end
        elseif input.KeyCode == Enum.KeyCode.KeypadTwo then
            Core:SetFlag("AutoFarm", not Core:GetFlag("AutoFarm"))
        elseif input.KeyCode == Enum.KeyCode.N then
            Core:SetFlag("Speed", not Core:GetFlag("Speed"))
        elseif input.KeyCode == Enum.KeyCode.Y then
            Core:SetFlag("InfiniteJump", not Core:GetFlag("InfiniteJump"))
        elseif input.KeyCode == Enum.KeyCode.KeypadZero then
            Core:SetFlag("ESP", not Core:GetFlag("ESP"))
        elseif input.KeyCode == Enum.KeyCode.KeypadThree then
            Core:SetFlag("HealthBars", not Core:GetFlag("HealthBars"))
        end
    end)

    player.CharacterAdded:Connect(function()
        Utils:invalidateCharCache()
        task.wait(0.3)
        if Core:GetFlag("Speed") then
            -- reconectar loop já está ativo via Combat
        end
        if Core:GetFlag("AutoAttack") then
            Combat:stopAutoAttack()
            Combat:startAutoAttack()
        end
    end)
end

Core:RegisterModule("Input", Input)

