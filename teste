-- PARTE 2: THEME (cores futuristas translúcidas)
-- ======================================================================
local Theme = {
    Colors = {
        -- Fundos translúcidos (preto/roxo/cinza)
        Background = Color3.fromRGB(10, 8, 15),      -- quase preto com toque roxo
        Surface = Color3.fromRGB(30, 20, 50),        -- roxo escuro
        SurfaceLight = Color3.fromRGB(60, 40, 90),   -- roxo médio
        Primary = Color3.fromRGB(150, 80, 255),      -- roxo vibrante
        PrimaryDark = Color3.fromRGB(100, 50, 200),  -- roxo escuro
        Text = Color3.fromRGB(255, 255, 255),        -- branco
        TextDim = Color3.fromRGB(200, 190, 220),     -- cinza lilás claro
        TextMuted = Color3.fromRGB(140, 130, 160),   -- cinza lilás médio
        Success = Color3.fromRGB(100, 220, 150),     -- verde
        Warning = Color3.fromRGB(255, 200, 80),      -- amarelo
        Danger = Color3.fromRGB(230, 80, 100),       -- vermelho
        Stroke = Color3.fromRGB(120, 80, 200),       -- borda roxa
    },
    Fonts = {
        Default = Enum.Font.Gotham,
        Bold = Enum.Font.GothamBold,
        Mono = Enum.Font.SourceSans,
    },
    Sizes = {
        Padding = 8,
        CornerRadius = 10,        -- mais arredondado para estilo futurista
        ToggleWidth = 38,
        ToggleHeight = 20,
        SliderHeight = 4,
        ButtonHeight = 35,
        SectionHeight = 30,
    },
    Animations = {
        Duration = 0.2,
        EasingStyle = Enum.EasingStyle.Quad,
        EasingDirection = Enum.EasingDirection.Out,
    },
    -- Transparências globais (aplicadas nos frames)
    Transparency = {
        Background = 0.85,
        Surface = 0.75,
        SurfaceLight = 0.60,
        Card = 0.70,
    }
}

-- Aplica estilo de "card" com transparência e borda roxa
function Theme:ApplyCard(frame)
    frame.BackgroundColor3 = self.Colors.Surface
    frame.BackgroundTransparency = self.Transparency.Card
    frame.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = frame
    local stroke = Instance.new("UIStroke")
    stroke.Color = self.Colors.Stroke
    stroke.Thickness = 1.5
    stroke.Transparency = 0.3
    stroke.Parent = frame
    return frame
end

-- Botão com hover e transparência
function Theme:ApplyButton(button, color)
    button.BackgroundColor3 = color or self.Colors.Primary
    button.BackgroundTransparency = 0.2
    button.TextColor3 = self.Colors.Text
    button.Font = self.Fonts.Bold
    button.TextSize = 12
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = button
    -- Hover: aumenta opacidade
    button.MouseEnter:Connect(function()
        self:Tween(button, { BackgroundTransparency = 0.05 }, 0.15)
    end)
    button.MouseLeave:Connect(function()
        self:Tween(button, { BackgroundTransparency = 0.2 }, 0.15)
    end)
    return button
end

-- Tween helper
function Theme:Tween(object, properties, duration)
    local tweenInfo = TweenInfo.new(
        duration or self.Animations.Duration,
        self.Animations.EasingStyle,
        self.Animations.EasingDirection
    )
    local tween = Core.Services.TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

