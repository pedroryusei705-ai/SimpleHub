-- PARTE 4: WINDOW (janela principal com sidebar)
-- ======================================================================
local Window = {}

function Window:CreateWindow(config)
    local title = config.title or "RyuHub"
    local size = config.size or Vector2.new(600, 700)
    local icon = config.icon or "✦"

    -- ScreenGui (com fundo transparente)
    local gui = Instance.new("ScreenGui")
    gui.Name = "RyuHub"
    gui.ResetOnSpawn = false
    gui.Parent = Core.Services.CoreGui

    -- Frame principal (transparente)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, size.X, 0, size.Y)
    frame.Position = UDim2.new(0, 20, 0.5, -size.Y/2)
    frame.BackgroundColor3 = Theme.Colors.Background
    frame.BackgroundTransparency = Theme.Transparency.Background
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    Theme:ApplyCard(frame) -- adiciona corner e stroke

    -- Topbar
    local topbar = Instance.new("Frame")
    topbar.Size = UDim2.new(1, 0, 0, 35)
    topbar.BackgroundColor3 = Theme.Colors.Surface
    topbar.BackgroundTransparency = Theme.Transparency.Surface
    topbar.BorderSizePixel = 0
    topbar.Parent = frame

    -- Título
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(0.8, 0, 1, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = icon .. " " .. title
    titleLabel.Font = Theme.Fonts.Bold
    titleLabel.TextSize = 14
    titleLabel.TextColor3 = Theme.Colors.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = topbar

    -- Botão fechar (estilo futurista)
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 2.5)
    closeBtn.BackgroundColor3 = Theme.Colors.Danger
    closeBtn.BackgroundTransparency = 0.3
    closeBtn.Text = "✕"
    closeBtn.Font = Theme.Fonts.Bold
    closeBtn.TextSize = 14
    closeBtn.TextColor3 = Theme.Colors.Text
    closeBtn.BorderSizePixel = 0
    closeBtn.Parent = topbar
    local cornerClose = Instance.new("UICorner")
    cornerClose.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
    cornerClose.Parent = closeBtn
    closeBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    -- Sidebar
    local sidebar = Instance.new("Frame")
    sidebar.Size = UDim2.new(0, 45, 1, -40)
    sidebar.Position = UDim2.new(0, 5, 0, 38)
    sidebar.BackgroundColor3 = Theme.Colors.Surface
    sidebar.BackgroundTransparency = Theme.Transparency.Surface
    sidebar.BorderSizePixel = 0
    sidebar.Parent = frame

    -- Layout da sidebar (vertical)
    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.Padding = UDim.new(0, 6)
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    sidebarLayout.Parent = sidebar

    -- Área de conteúdo
    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -60, 1, -40)
    content.Position = UDim2.new(0, 55, 0, 38)
    content.BackgroundTransparency = 1
    content.Parent = frame

    -- Tabelas de páginas
    local pages = {}
    local pageButtons = {}

    function Window:CreatePage(name, pageIcon)
        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.new(1, -5, 1, 0)
        page.BackgroundTransparency = 1
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = Theme.Colors.Stroke
        page.ScrollBarImageTransparency = 0.5
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.Visible = false
        page.Parent = content

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 8)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = page

        -- Botão na sidebar
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 35, 0, 35)
        btn.BackgroundColor3 = Theme.Colors.SurfaceLight
        btn.BackgroundTransparency = Theme.Transparency.SurfaceLight
        btn.Text = pageIcon or "●"
        btn.Font = Theme.Fonts.Bold
        btn.TextSize = 18
        btn.TextColor3 = Theme.Colors.TextMuted
        btn.BorderSizePixel = 0
        btn.Parent = sidebar
        local cornerBtn = Instance.new("UICorner")
        cornerBtn.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
        cornerBtn.Parent = btn

        -- Tooltip (opcional)
        local tooltip = Instance.new("TextLabel")
        tooltip.Size = UDim2.new(0, 80, 0, 20)
        tooltip.Position = UDim2.new(1, 5, 0.5, -10)
        tooltip.BackgroundColor3 = Theme.Colors.Surface
        tooltip.BackgroundTransparency = Theme.Transparency.Surface
        tooltip.Text = name
        tooltip.Font = Theme.Fonts.Default
        tooltip.TextSize = 10
        tooltip.TextColor3 = Theme.Colors.Text
        tooltip.Visible = false
        tooltip.Parent = btn
        local cornerTip = Instance.new("UICorner")
        cornerTip.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
        cornerTip.Parent = tooltip

        btn.MouseEnter:Connect(function()
            tooltip.Visible = true
        end)
        btn.MouseLeave:Connect(function()
            tooltip.Visible = false
        end)

        table.insert(pages, page)
        table.insert(pageButtons, btn)

        btn.MouseButton1Click:Connect(function()
            Window:SwitchPage(page)
        end)

        return page
    end

    function Window:SwitchPage(targetPage)
        for _, p in ipairs(pages) do
            p.Visible = false
        end
        for _, b in ipairs(pageButtons) do
            b.BackgroundColor3 = Theme.Colors.SurfaceLight
            b.BackgroundTransparency = Theme.Transparency.SurfaceLight
            b.TextColor3 = Theme.Colors.TextMuted
        end
        targetPage.Visible = true
        for i, p in ipairs(pages) do
            if p == targetPage then
                pageButtons[i].BackgroundColor3 = Theme.Colors.Primary
                pageButtons[i].BackgroundTransparency = 0.2
                pageButtons[i].TextColor3 = Theme.Colors.Text
            end
        end
    end

    -- Retorna interface pública
    return {
        Frame = frame,
        Gui = gui,
        CreatePage = Window.CreatePage,
        SwitchPage = Window.SwitchPage,
        Destroy = function()
            gui:Destroy()
        end
    }
end

