-- PARTE 3: WIDGETS (Toggle, Slider, etc.)
-- ======================================================================
local Widgets = {}

function Widgets:Toggle(parent, config)
    local flag = config.flag
    local label = config.label
    local desc = config.desc
    local default = config.default or false

    -- Container com fundo translúcido
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, desc and 55 or 40)
    container.BackgroundColor3 = Theme.Colors.Surface
    container.BackgroundTransparency = Theme.Transparency.Surface
    container.BorderSizePixel = 0
    container.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, Theme.Sizes.CornerRadius)
    corner.Parent = container

    -- Label
    local labelObj = Instance.new("TextLabel")
    labelObj.Size = UDim2.new(0.7, -10, 0, 20)
    labelObj.Position = UDim2.new(0, 10, 0, desc and 8 or 10)
    labelObj.BackgroundTransparency = 1
    labelObj.Text = label
    labelObj.Font = Theme.Fonts.Default
    labelObj.TextSize = 12
    labelObj.TextColor3 = Theme.Colors.Text
    labelObj.TextXAlignment = Enum.TextXAlignment.Left
    labelObj.Parent = container

    if desc then
        local descObj = Instance.new("TextLabel")
        descObj.Size = UDim2.new(1, -20, 0, 18)
        descObj.Position = UDim2.new(0, 10, 0, 28)
        descObj.BackgroundTransparency = 1
        descObj.Text = desc
        descObj.Font = Theme.Fonts.Default
        descObj.TextSize = 9
        descObj.TextColor3 = Theme.Colors.TextMuted
        descObj.TextWrapped = true
        descObj.Parent = container
    end

    -- Toggle background
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(0, Theme.Sizes.ToggleWidth, 0, Theme.Sizes.ToggleHeight)
    bg.Position = UDim2.new(1, -(Theme.Sizes.ToggleWidth + 7), 0, 10)
    bg.BackgroundColor3 = Theme.Colors.SurfaceLight
    bg.BackgroundTransparency = Theme.Transparency.SurfaceLight
    bg.BorderSizePixel = 0
    bg.Parent = container
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(1, 0)
    bgCorner.Parent = bg

    -- Circle
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = Theme.Colors.Text
    circle.BackgroundTransparency = 0
    circle.BorderSizePixel = 0
    circle.Parent = bg
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle

    -- Botão interativo
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = bg

    -- Estado
    local function setState(value)
        Core:SetFlag(flag, value)
        Theme:Tween(bg, {
            BackgroundColor3 = value and Theme.Colors.Primary or Theme.Colors.SurfaceLight,
            BackgroundTransparency = value and 0.1 or Theme.Transparency.SurfaceLight
        })
        Theme:Tween(circle, {
            Position = value and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        })
    end

    local initial = Core:GetFlag(flag, default)
    setState(initial)

    btn.MouseButton1Click:Connect(function()
        setState(not Core:GetFlag(flag))
    end)

    local widget = {
        Update = function(value)
            Theme:Tween(bg, {
                BackgroundColor3 = value and Theme.Colors.Primary or Theme.Colors.SurfaceLight,
                BackgroundTransparency = value and 0.1 or Theme.Transparency.SurfaceLight
            })
            Theme:Tween(circle, {
                Position = value and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            })
        end
    }
    Core:RegisterWidget(flag, widget)

    return container, widget
end

