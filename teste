local Combat = {}

function Combat:Init()
    -- Conecta os loops principais
    Core.Connections.AutoFarm = Core.Services.RunService.Heartbeat:Connect(function()
        if Core:GetFlag("AutoFarm") then
            self:AutoFarmLoop()
        end
    end)

    Core.Connections.LockOn = Core.Services.RunService.RenderStepped:Connect(function()
        if Core:GetFlag("LockOn") then
            self:LockOnLoop()
        end
    end)

    Core.Connections.Speed = Core.Services.RunService.Heartbeat:Connect(function()
        if Core:GetFlag("Speed") then
            self:SpeedLoop()
        end
    end)

    -- Reage a mudanças na flag AutoAttack
    Core:Connect("FlagChanged", function(flag, value)
        if flag == "AutoAttack" then
            if value then
                self:StartAutoAttack()
            else
                self:StopAutoAttack()
            end
        end
    end)

    -- Inicia autoattack se já estiver ativo
    if Core:GetFlag("AutoAttack") then
        self:StartAutoAttack()
    end
end

-- ============================================================
-- AUXILIARES DO COMBAT
-- ============================================================
function Combat:getCharComponents()
    local char = player.Character
    if not char then return nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return nil, nil end
    return root, hum
end

function Combat:findClosestNPC()
    local root = self:getCharComponents()
    if not root then return nil end
    local closest = nil
    local closestDist = math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= player.Character then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = obj
                end
            end
        end
    end
    return closest
end

-- ============================================================
-- AUTO ATTACK
-- ============================================================
local autoAttackThread = nil
local autoAttackRunning = false
local attackCooldown = 0.12

function Combat:StartAutoAttack()
    if autoAttackThread then return end
    autoAttackRunning = true
    autoAttackThread = task.spawn(function()
        local remote = game.ReplicatedStorage:FindFirstChild("Events") and game.ReplicatedStorage.Events:FindFirstChild("CombatEvent")
        if not remote then
            warn("[Combat] Remote não encontrado, AutoAttack não funcionará.")
            return
        end
        local char = player.Character or player.CharacterAdded:Wait()
        local weapon = char:FindFirstChild("FistCombat") and char.FistCombat:FindFirstChild("WeaponInfoFolder") and char.FistCombat.WeaponInfoFolder:FindFirstChild("Fist")
        if not weapon then
            warn("[Combat] Arma Fist não encontrada, AutoAttack pode falhar.")
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then
            warn("[Combat] HumanoidRootPart não encontrado.")
            return
        end

        while autoAttackRunning do
            task.wait(attackCooldown)

            local target = nil
            -- tenta pegar alvo do LockOn ou AutoFarm
            if Core:GetFlag("LockOn") then
                -- se LockOn estiver ativo, usamos o alvo que a câmera está seguindo? 
                -- Vamos simplesmente buscar o NPC mais próximo
                target = self:findClosestNPC()
            elseif Core:GetFlag("AutoFarm") then
                target = self:findClosestNPC()
            else
                target = self:findClosestNPC()
            end

            local burst = Core:GetFlag("BurstCount", 3)
            if burst < 1 then burst = 1 end

            if target then
                local npcRoot = target:FindFirstChild("HumanoidRootPart")
                if npcRoot then
                    local attackPos = npcRoot.Position
                    local mode = Core:GetFlag("AutofarmMode", "Behind")
                    local distance = Core:GetFlag("AutofarmDistance", 3)
                    if mode == "Behind" then
                        local backVec = -npcRoot.CFrame.LookVector * distance
                        attackPos = npcRoot.Position + backVec + Vector3.new(0, 2.5, 0)
                    elseif mode == "Above" then
                        attackPos = npcRoot.Position + Vector3.new(0, distance, 0)
                    end
                    local cframe = CFrame.new(attackPos, npcRoot.Position)
                    for _ = 1, burst do
                        remote:FireServer(1, weapon, cframe, true, weapon)
                        remote:FireServer(2, weapon, cframe, true, weapon)
                        remote:FireServer(3, weapon, cframe, true, weapon)
                        remote:FireServer(4, weapon, cframe, true, weapon)
                    end
                end
            else
                -- ataque no vazio
                if root then
                    local cframe = root.CFrame * CFrame.new(0, 0, -3)
                    for _ = 1, burst do
                        remote:FireServer(1, weapon, cframe, true, weapon)
                        remote:FireServer(2, weapon, cframe, true, weapon)
                        remote:FireServer(3, weapon, cframe, true, weapon)
                        remote:FireServer(4, weapon, cframe, true, weapon)
                    end
                end
            end
        end
    end)
end

function Combat:StopAutoAttack()
    autoAttackRunning = false
    if autoAttackThread then
        task.cancel(autoAttackThread)
        autoAttackThread = nil
    end
end

-- ============================================================
-- LOCK ON
-- ============================================================
function Combat:LockOnLoop()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local target = self:findClosestNPC()
    if not target then return end
    local npcRoot = target:FindFirstChild("HumanoidRootPart")
    if not npcRoot then return end
    local currentPos = camera.CFrame.Position
    local targetPos = npcRoot.Position
    local lookAt = CFrame.new(currentPos, targetPos)
    camera.CFrame = camera.CFrame:Lerp(lookAt, 0.35)
end

-- ============================================================
-- AUTOFARM
-- ============================================================
function Combat:AutoFarmLoop()
    local root, hum = self:getCharComponents()
    if not root then return end
    local target = self:findClosestNPC()
    if not target then return end
    local npcRoot = target:FindFirstChild("HumanoidRootPart")
    if not npcRoot then return end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local mode = Core:GetFlag("AutofarmMode", "Behind")
    local distance = Core:GetFlag("AutofarmDistance", 3)

    if mode == "Above" then
        local targetPos = npcRoot.Position + Vector3.new(0, distance, 0)
        root.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(-90), 0, 0)
    else -- Behind
        local backVec = -npcRoot.CFrame.LookVector * distance
        local upVec = Vector3.new(0, 2.5, 0)
        local targetPos = npcRoot.Position + backVec + upVec
        root.CFrame = CFrame.new(targetPos, npcRoot.Position)
    end
end

-- ============================================================
-- SPEED
-- ============================================================
function Combat:SpeedLoop()
    local root, hum = self:getCharComponents()
    if not root or not hum then return end
    local moveDir = hum.MoveDirection
    if moveDir.Magnitude > 0 then
        local speed = Core:GetFlag("SpeedValue", 16)
        local curY = root.AssemblyLinearVelocity.Y
        root.AssemblyLinearVelocity = (moveDir.Unit * speed) + Vector3.new(0, curY, 0)
    end
end

-- Registra o módulo no Core
Core:RegisterModule("Combat", Combat)

