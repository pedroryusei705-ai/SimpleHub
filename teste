        Text = Color3.fromRGB(255, 255, 255),
        TextDim = Color3.fromRGB(200, 190, 220),
        TextMuted = Color3.fromRGB(140, 130, 160),
        Success = Color3.fromRGB(100, 220, 150),
        Warning = Color3.fromRGB(255, 200, 80),
        Danger = Color3.fromRGB(230, 80, 100),
        Stroke = Color3.fromRGB(120, 80, 200),
    },
    Fonts = {
        Default = Enum.Font.Gotham,
        Bold = Enum.Font.GothamBold,
        Mono = Enum.Font.SourceSans,
    },
    Sizes = {
        Padding = 8,
        CornerRadius = 10,
        ToggleWidth = 38,
        ToggleHeight = 20,
        SliderHeight = 4,
        ButtonHeight = 35,
        SectionHeight = 30,
    },
    Animations = {
        Duration = 0.2,
        EasingStyle = Enum.EasingStyle.Quad,
        EasingDirection = Enum.EasingDirection.Out,
    },
    Transparency = {
        Background = 0.85,
        Surface = 0.75,
        SurfaceLight = 0.60,
        Card = 0.70,
    }
}

function Theme:ApplyCard(frame)
    frame.BackgroundColor3 = self.Colors.Surface
    frame.BackgroundTransparency = self.Transparency.Card
    frame.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = frame
    local stroke = Instance.new("UIStroke")
    stroke.Color = self.Colors.Stroke
    stroke.Thickness = 1.5
    stroke.Transparency = 0.3
    stroke.Parent = frame
    return frame
end

function Theme:ApplyButton(button, color)
    button.BackgroundColor3 = color or self.Colors.Primary
    button.BackgroundTransparency = 0.2
    button.TextColor3 = self.Colors.Text
    button.Font = self.Fonts.Bold
    button.TextSize = 12
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, self.Sizes.CornerRadius)
    corner.Parent = button
    button.MouseEnter:Connect(function()
        self:Tween(button, { BackgroundTransparency = 0.05 }, 0.15)
    end)
    button.MouseLeave:Connect(function()
        self:Tween(button, { BackgroundTransparency = 0.2 }, 0.15)
    end)
    return button
end

function Theme:Tween(object, properties, duration)
    local tweenInfo = TweenInfo.new(
        duration or self.Animations.Duration,
        self.Animations.EasingStyle,
        self.Animations.EasingDirection
    )
    local tween = Core.Services.TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

