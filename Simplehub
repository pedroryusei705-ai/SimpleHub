--//   SIMPLE HUB - SPEED + JUMP + AUTO ATTACK (FIXED) --//
--//====================================================--

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

-- Remote
local swingRemote = ReplicatedStorage:WaitForChild("RsPackage"):WaitForChild("Swing")

-- Nome do jogo
local gameName = game.Name
pcall(function()
    local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    if info and info.Name then gameName = info.Name end
end)

-- Estado
local state = {
    speedEnabled = false,
    speedValue = 160,
    infiniteJumpEnabled = false,

    autoAttackEnabled = false,
    attackCPS = 6,
    attackRange = 25,
}

-- Cache personagem
local charCache = { root=nil, hum=nil, lastUpdate=0 }
local function getCharComponents()
    local now = tick()
    if now - charCache.lastUpdate > 0.3 then
        local char = LocalPlayer.Character
        charCache.root = char and char:FindFirstChild("HumanoidRootPart")
        charCache.hum = char and char:FindFirstChildOfClass("Humanoid")
        charCache.lastUpdate = now
    end
    return charCache.root, charCache.hum
end

-- Conexões
local connections = {}
local function disconnect(name)
    if connections[name] then
        connections[name]:Disconnect()
        connections[name] = nil
    end
end

-- SPEED
local function speedLoop()
    if not state.speedEnabled then return end
    local root, hum = getCharComponents()
    if root and hum then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            local curY = root.AssemblyLinearVelocity.Y
            root.AssemblyLinearVelocity = (moveDir.Unit * state.speedValue) + Vector3.new(0, curY, 0)
        end
    end
end

local function setSpeed(enabled)
    state.speedEnabled = enabled
    if enabled then
        disconnect("speed")
        connections.speed = RunService.Heartbeat:Connect(speedLoop)
    else
        disconnect("speed")
    end
end

-- INFINITE JUMP
local function setInfiniteJump(enabled)
    state.infiniteJumpEnabled = enabled
end

-- TARGET SYSTEM
local function getClosestTarget()
    local root = getCharComponents()
    if not root then return nil end

    local closest = nil
    local shortest = state.attackRange

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = player
                end
            end
        end
    end

    return closest
end

-- AUTO ATTACK
local lastAttack = 0

local function autoAttackLoop()
    if not state.autoAttackEnabled then return end

    local delay = 1 / state.attackCPS
    if tick() - lastAttack < delay then return end

    local target = getClosestTarget()
    if not target then return end

    lastAttack = tick()

    pcall(function()
        swingRemote:FireServer()
    end)
end

local function setAutoAttack(enabled)
    state.autoAttackEnabled = enabled
    if enabled then
        disconnect("autoattack")
        connections.autoattack = RunService.Heartbeat:Connect(autoAttackLoop)
    else
        disconnect("autoattack")
    end
end

-- GUI (MESMA BASE DO SEU)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SimpleHub"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local mainFrame = Instance.new("Frame")
