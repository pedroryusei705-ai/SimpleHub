	tracersToggle.MouseButton1Click:Connect(function() setTracers(not State.tracersEnabled) end)

	local function setHealthBars(enabled)
		State.healthBarsEnabled = enabled
		Utils.animateToggle(healthBarsBg, healthBarsCircle, enabled)
		if not enabled then ESP.clearAllHealthBars() end
	end
	healthBarsToggle.MouseButton1Click:Connect(function() setHealthBars(not State.healthBarsEnabled) end)

	local function setPlayerESP(enabled)
		State.playerESPEnabled = enabled
		Utils.animateToggle(playerESPBg, playerESPCircle, enabled)
	end
	playerESPToggle.MouseButton1Click:Connect(function() setPlayerESP(not State.playerESPEnabled) end)

	local function setNoClip(enabled)
		State.noClipEnabled = enabled
		Utils.animateToggle(noClipBg, noClipCircle, enabled)
		if enabled then
			Movement.enableNoClip()
			Utils.disconnectConnection("noClip")
			State.connections.noClip = RunService.Heartbeat:Connect(function()
				if State.noClipEnabled then Movement.enableNoClip() end
			end)
		else
			Movement.disableNoClip()
			Utils.disconnectConnection("noClip")
		end
	end
	noClipToggle.MouseButton1Click:Connect(function() setNoClip(not State.noClipEnabled) end)

	-- Sliders
	handleSlider(killAuraDelaySlider, killAuraDelayFill, killAuraDelayLabel, killAuraMin, killAuraMax, 10, function(v) State.killAuraDelay = v end)
	handleSlider(autofarmDistSlider, autofarmDistFill, autofarmDistLabel, afMin, afMax, 10, function(v) State.autofarmDistance = v end)
	handleSlider(speedValSlider, speedValFill, speedValLabel, spMin, spMax, 1, function(v) State.speedValue = v end)

	toggleRefs = {
		killAura = { bg = killAuraBg, circle = killAuraCircle },
		autofarm = { bg = autofarmBg, circle = autofarmCircle },
		lockOn = { bg = lockOnBg, circle = lockOnCircle },
		speed = { bg = speedBg, circle = speedCircle },
		infiniteJump = { bg = jumpBg, circle = jumpCircle },
		esp = { bg = espBg, circle = espCircle },
		tracers = { bg = tracersBg, circle = tracersCircle },
		healthBars = { bg = healthBarsBg, circle = healthBarsCircle },
		playerESP = { bg = playerESPBg, circle = playerESPCircle },
		noClip = { bg = noClipBg, circle = noClipCircle },
	}

	return screenGui, mainFrame, toggleRefs
end

-- ===================== SISTEMA DE INPUT =====================
local function initInput()
	UserInputService.JumpRequest:Connect(function()
		if State.infiniteJumpEnabled then
			local _, hum = Utils.getCharComponents()
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		-- Se outro script já processou, ignoramos
		if processed then return end

		if input.KeyCode == Enum.KeyCode.F1 then
			mainFrame.Visible = not mainFrame.Visible
		elseif input.KeyCode == Enum.KeyCode.F2 then
			if toggleRefs.killAura then
				setKillAura(not State.killAuraEnabled)
			end
		elseif input.KeyCode == Enum.KeyCode.F3 then
			if toggleRefs.autofarm then
				setAutofarm(not State.autofarmEnabled)
			end
		elseif input.KeyCode == Enum.KeyCode.KeypadOne or input.KeyCode == Enum.KeyCode.One then
			if toggleRefs.speed then
				setSpeed(not State.speedEnabled)
			end
		elseif input.KeyCode == Enum.KeyCode.KeypadTwo or input.KeyCode == Enum.KeyCode.Two then
			if toggleRefs.infiniteJump then
				setInfiniteJump(not State.infiniteJumpEnabled)
			end
		elseif input.KeyCode == Enum.KeyCode.KeypadZero or input.KeyCode == Enum.KeyCode.Zero then
			if toggleRefs.esp then
				setESP(not State.espEnabled)
			end
		end
	end)

	LocalPlayer.CharacterAdded:Connect(function()
		Utils.invalidateCharCache()
		task.wait(0.3)
		if State.speedEnabled then
			Utils.disconnectConnection("speed")
			State.connections.speed = RunService.Heartbeat:Connect(Combat.speedLoop)
		end
		if State.killAuraEnabled then
			Utils.disconnectConnection("killAura")
			State.connections.killAura = RunService.Heartbeat:Connect(Combat.killAuraLoop)
		end
		if State.autofarmEnabled then
			Utils.disconnectConnection("autofarm")
			State.connections.autofarm = RunService.Heartbeat:Connect(Combat.autofarmLoop)
		end
		if State.lockOnEnabled then
			Utils.disconnectConnection("lockOn")
			State.connections.lockOn = RunService.RenderStepped:Connect(Combat.lockOnLoop)
		end
		if State.noClipEnabled then
			Utils.disconnectConnection("noClip")
			State.connections.noClip = RunService.Heartbeat:Connect(function()
				if State.noClipEnabled then Movement.enableNoClip() end
			end)
		end
	end)
end

-- ===================== INICIALIZAÇÃO =====================
local guiResult = GUI.build()
screenGui = guiResult[1]
mainFrame = guiResult[2]
toggleRefs = guiResult[3]

initInput()

State.connections.visualUpdate = RunService.RenderStepped:Connect(function()
	ESP.updateVisuals()
	ESP.updatePlayerESP()
end)

screenGui.Destroying:Connect(function()
	for _, conn in pairs(State.connections) do
		if conn then pcall(conn.Disconnect, conn) end
	end
	ESP.clearAllESP()
	ESP.clearAllTracers()
	ESP.clearAllHealthBars()
	for _, esp in pairs(State.playerESPObjects) do
		if esp then esp:Destroy() end
	end
end)

