-- Função auxiliar para obter a pasta com fallback
local function getFolderSafe(parent, name)
	local folder = parent:FindFirstChild(name)
	if not folder then
		warn("Pasta '" .. name .. "' não encontrada. Usando o pai como fallback.")
		return parent
	end
	return folder
end

