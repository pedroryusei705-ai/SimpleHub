contentFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
contentFrame.Parent = mainFrame

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.Parent = contentFrame

-- TOGGLE PADRÃO
local function createToggle(parent, text, key, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1,0,0,40)
    frame.BackgroundColor3 = Color3.fromRGB(18,18,25)
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7,0,1,0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1,1,1)
    label.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0,40,0,20)
    btn.Position = UDim2.new(1,-50,0.5,-10)
    btn.Parent = frame

    btn.MouseButton1Click:Connect(function()
        local new = not state[key]
        state[key] = new
        callback(new)
    end)
end

-- SLIDER PADRÃO
local function createSlider(parent, text, min, max, defaultVal, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1,0,0,50)
    frame.BackgroundColor3 = Color3.fromRGB(18,18,25)
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,0,20)
    label.BackgroundTransparency = 1
    label.Text = text.." ("..defaultVal..")"
    label.TextColor3 = Color3.new(1,1,1)
    label.Parent = frame

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local pct = math.clamp((UserInputService:GetMouseLocation().X - frame.AbsolutePosition.X)/frame.AbsoluteSize.X,0,1)
            local value = math.floor((min + (max-min)*pct)*10)/10
            label.Text = text.." ("..value..")"
            callback(value)
        end
    end)
end

-- ELEMENTOS
createToggle(contentFrame, "Speed", "speedEnabled", setSpeed)
createToggle(contentFrame, "Infinite Jump", "infiniteJumpEnabled", setInfiniteJump)
createToggle(contentFrame, "Auto Attack", "autoAttackEnabled", setAutoAttack)

createSlider(contentFrame, "Attack CPS", 1, 20, state.attackCPS, function(v)
    state.attackCPS = v
end)

-- JUMP LOOP
UserInputService.JumpRequest:Connect(function()
    if state.infiniteJumpEnabled then
        local _, hum = getCharComponents()
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- BINDS
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.KeypadOne then
        setSpeed(not state.speedEnabled)
    elseif input.KeyCode == Enum.KeyCode.KeypadTwo then
        setInfiniteJump(not state.infiniteJumpEnabled)
    elseif input.KeyCode == Enum.KeyCode.KeypadThree then
        setAutoAttack(not state.autoAttackEnabled)
    end
end)

print("Simple Hub FULL carregado (Auto Attack + CPS + Target)")
