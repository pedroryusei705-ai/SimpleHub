--//====================================================--
--//   SIMPLE HUB - SPEED + JUMP + AUTO ATTACK (CPS)   --//
--//====================================================--

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

-- Remote
local SwingRemote = ReplicatedStorage:WaitForChild("RsPackage"):WaitForChild("Swing")

-- Nome do jogo
local gameName = game.Name
pcall(function()
    local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    if info and info.Name then gameName = info.Name end
end)

-- Estado
local state = {
    speedEnabled = false,
    speedValue = 160,
    infiniteJumpEnabled = false,

    autoAttackEnabled = false,
    attackCPS = 5, -- ataques por segundo
}

-- Cache personagem
local charCache = {root=nil, hum=nil, lastUpdate=0}
local function getCharComponents()
    if tick() - charCache.lastUpdate > 0.3 then
        local char = LocalPlayer.Character
        charCache.root = char and char:FindFirstChild("HumanoidRootPart")
        charCache.hum = char and char:FindFirstChildOfClass("Humanoid")
        charCache.lastUpdate = tick()
    end
    return charCache.root, charCache.hum
end

-- Conexões
local connections = {}
local function disconnect(name)
    if connections[name] then
        connections[name]:Disconnect()
        connections[name] = nil
    end
end

-- SPEED
local function speedLoop()
    if not state.speedEnabled then return end
    local root, hum = getCharComponents()
    if root and hum then
        local dir = hum.MoveDirection
        if dir.Magnitude > 0 then
            local y = root.AssemblyLinearVelocity.Y
            root.AssemblyLinearVelocity = (dir.Unit * state.speedValue) + Vector3.new(0, y, 0)
        end
    end
end

local function setSpeed(v)
    state.speedEnabled = v
    disconnect("speed")
    if v then
        connections.speed = RunService.Heartbeat:Connect(speedLoop)
    end
end

-- AUTO ATTACK (COM DELAY)
local lastAttack = 0

local function autoAttackLoop()
    if not state.autoAttackEnabled then return end

    local delay = 1 / state.attackCPS
    if tick() - lastAttack >= delay then
        lastAttack = tick()

        pcall(function()
            SwingRemote:FireServer()
        end)
    end
end

local function setAutoAttack(v)
    state.autoAttackEnabled = v
    disconnect("autoattack")
    if v then
        connections.autoattack = RunService.Heartbeat:Connect(autoAttackLoop)
    end
end

-- INFINITE JUMP
local function setInfiniteJump(v)
    state.infiniteJumpEnabled = v
end

-- GUI
local screenGui = Instance.new("ScreenGui", CoreGui)
screenGui.Name = "SimpleHub"
screenGui.ResetOnSpawn = false

local mainFrame = Instance.new("Frame", screenGui)
mainFrame.Size = UDim2.new(0, 340, 0, 360)
mainFrame.Position = UDim2.new(0.5, -170, 0.5, -180)
mainFrame.BackgroundColor3 = Color3.fromRGB(13,13,18)
mainFrame.Active = true
mainFrame.Draggable = true

Instance.new("UICorner", mainFrame)

-- Layout
local content = Instance.new("ScrollingFrame", mainFrame)
content.Size = UDim2.new(1, -20, 1, -20)
content.Position = UDim2.new(0,10,0,10)
content.BackgroundTransparency = 1
content.AutomaticCanvasSize = Enum.AutomaticSize.Y

local layout = Instance.new("UIListLayout", content)
layout.Padding = UDim.new(0,8)

-- Toggle
local function createToggle(text, key, callback)
    local frame = Instance.new("Frame", content)
    frame.Size = UDim2.new(1,0,0,40)
    frame.BackgroundColor3 = Color3.fromRGB(18,18,25)

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(0.7,0,1,0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1,1,1)

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0,40,0,20)
    btn.Position = UDim2.new(1,-50,0.5,-10)

    btn.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        callback(state[key])
    end)
end

-- Slider
local function createSlider(text, min, max, val, callback)
    local frame = Instance.new("Frame", content)
    frame.Size = UDim2.new(1,0,0,50)

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1,0,0,20)
    label.BackgroundTransparency = 1
    label.Text = text.." ("..val..")"
    label.TextColor3 = Color3.new(1,1,1)

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local pct = math.random()
            local newVal = math.floor((min + (max-min)*pct)*10)/10
            state.attackCPS = newVal
            label.Text = text.." ("..newVal..")"
            callback(newVal)
        end
    end)
end

-- ELEMENTOS
createToggle("Speed", "speedEnabled", setSpeed)
createToggle("Infinite Jump", "infiniteJumpEnabled", setInfiniteJump)
createToggle("Auto Attack", "autoAttackEnabled", setAutoAttack)

createSlider("Attack CPS", 1, 20, state.attackCPS, function(v)
    state.attackCPS = v
end)

-- LOOP JUMP
UserInputService.JumpRequest:Connect(function()
    if state.infiniteJumpEnabled then
        local _, hum = getCharComponents()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- TECLAS
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.KeypadOne then
        setSpeed(not state.speedEnabled)
    elseif input.KeyCode == Enum.KeyCode.KeypadTwo then
        setInfiniteJump(not state.infiniteJumpEnabled)
    elseif input.KeyCode == Enum.KeyCode.KeypadThree then
        setAutoAttack(not state.autoAttackEnabled)
    end
end)

print("Simple Hub carregado com Auto Attack + CPS")
