local function handleSlider(btn, fill, label, minV, maxV, precision, callback)
	local dragging = false
	btn.MouseButton1Down:Connect(function() dragging = true end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local sliderBg = btn.Parent
			local mouseX = UserInputService:GetMouseLocation().X
			local pct = math.clamp((mouseX - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
			local value = minV + pct * (maxV - minV)
			value = math.floor(value * precision) / precision
			label.Text = tostring(value)
			fill.Size = UDim2.new(pct, 0, 1, 0)
			if callback then callback(value) end
		end
	end)
end

local function makeResizable(frame)
	local grip = Instance.new("Frame")
	grip.Size = UDim2.new(0, 8, 0, 8)
	grip.Position = UDim2.new(1, -8, 1, -8)
	grip.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
	grip.BackgroundTransparency = 0.5
	grip.BorderSizePixel = 0
	grip.Parent = frame
	Instance.new("UICorner", grip).CornerRadius = UDim.new(0, 2)
	grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizeActive = true
			resizeStartPos = UserInputService:GetMouseLocation()
			resizeStartSize = frame.AbsoluteSize
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizeActive = false
					conn:Disconnect()
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if resizeActive and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = UserInputService:GetMouseLocation() - resizeStartPos
			local newWidth = math.max(CONFIG.GUI_MIN_SIZE.X, resizeStartSize.X + delta.X)
			local newHeight = math.max(CONFIG.GUI_MIN_SIZE.Y, resizeStartSize.Y + delta.Y)
			frame.Size = UDim2.new(0, newWidth, 0, newHeight)
		end
	end)
end

